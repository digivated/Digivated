{
  "prefetch": [
    {
      "source": "document",
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": "/api/*" } },
          { "not": { "href_matches": "/admin*" } },
          { "not": { "href_matches": "/login*" } },
          { "not": { "href_matches": "/auth*" } },
          { "not": { "href_matches": "/*callback*" } },
          { "not": { "href_matches": "/email-preferences*" } },
          { "not": { "href_matches": "/downloads/*" } },
          { "not": { "href_matches": "/video-player*" } },
          { "not": { "href_matches": "/invstr*" } },
          { "not": { "href_matches": "/*\\?*token*" } },
          { "not": { "selector_matches": "[download], [target=_blank], [rel~=nofollow], [data-no-prefetch]" } }
        ]
      },
      "eagerness": "moderate"
    }
  ]
}
