---
import Platform from '../layouts/Platform.astro';
import '../styles/project-account.css';
import MakerNavigation from '../components/MakerNavigation.astro';
import FeedbackPoints from '../components/FeedbackPoints.astro';
---
<Platform title="Your Projects" description="Your Digivated dashboard: track launches, read feedback, and manage your profile.">
  <header class="page-intro fl-dash-intro"><div><h1>Maker dashboard</h1><p class="lede">Track your launches.</p></div></header>
  <section class="project-account-card fl-dash" aria-label="Project account">
    <p id="account-state" class="fl-status" role="status" aria-live="polite">Connecting to account sign-in…</p>
    <form id="account-password-reset" class="login-panel fl-card fl-form fl-panel-pad" hidden>
      <label for="account-new-password">New password</label>
      <input id="account-new-password" name="password" type="password" autocomplete="new-password" minlength="10" required aria-describedby="account-password-help"/>
      <p id="account-password-help" class="fl-hint">Use at least 10 characters.</p>
      <label for="account-confirm-password">Confirm new password</label>
      <input id="account-confirm-password" name="confirmation" type="password" autocomplete="new-password" minlength="10" required/>
      <button class="button primary" type="submit">Save new password</button>
    </form>
    <div id="account-sign-in" class="account-actions fl-card fl-panel-pad fl-empty" hidden><div class="fl-actions"><a class="button primary" href="/login">Log in or sign up</a><a class="fl-btn" href="/discover?view=featured">Browse member projects</a></div></div>
    <div id="account-signed-in" hidden>
      <MakerNavigation/>
      <div class="fl-dash-bar"><p>Signed in as <strong id="account-email"></strong></p><button class="fl-link" id="account-sign-out" type="button">Sign out</button></div>
      <section id="account-panel-projects" role="tabpanel" aria-labelledby="account-tab-projects" class="fl-tabpanel">
        <h2 id="account-submissions-title" class="sr-only">My submissions</h2>
        <dl class="launch-totals" id="launch-totals" hidden>
          <div><dt>Projects</dt><dd data-count="total"></dd></div>
          <div><dt>Scheduled</dt><dd data-count="scheduled"></dd></div>
          <div><dt>Live</dt><dd data-count="live"></dd></div>
        </dl>
        <div id="account-submissions" aria-live="polite"><p class="fl-status">Loading your projects…</p></div>
        <details class="account-points">
          <summary>Feedback points</summary>
          <FeedbackPoints heading="Give feedback, get bonus upvotes on your launch."/>
        </details>
      </section>
      <section id="account-panel-analytics" role="tabpanel" aria-labelledby="account-tab-analytics" class="fl-tabpanel" hidden>
        <div class="fl-card fl-panel-pad"><h2>How your launches are doing</h2>
          <p>See views, visits, votes, and comments for your published projects.</p>
          <label id="analytics-picker" hidden>Project <select id="analytics-project"></select></label>
          <div id="analytics-result" aria-live="polite">Loading projects…</div>
        </div>
      </section>
      <section id="account-panel-profile" role="tabpanel" aria-labelledby="account-tab-profile" class="fl-tabpanel" hidden>
        <section class="creator-profile-editor fl-card fl-panel-pad" aria-labelledby="creator-profile-title"><h2 id="creator-profile-title">Your maker profile</h2><p>Shown on your launches when your profile is public.</p><form id="creator-profile-form" class="fl-form"><div class="creator-logo-editor"><span class="creator-avatar" id="creator-logo-preview" aria-hidden="true">D</span><label>Profile logo <span class="quiet">(PNG, JPG or WebP)</span><input id="creator-logo-input" type="file" accept="image/png,image/jpeg,image/webp"/><small>Square images work best. Your logo appears on your creator profile.</small></label></div><label>Display name<input name="name" maxlength="60" required placeholder="Your name or studio"/></label><label>Short bio<textarea name="bio" maxlength="240" rows="3" placeholder="What are you building?"></textarea></label><label>Website <span class="quiet">(optional)</span><input name="website" type="url" maxlength="300" placeholder="https://your-site.com"/></label><label>Social profile <span class="quiet">(optional)</span><input name="social" type="url" maxlength="300" placeholder="https://x.com/yourname"/></label><label class="creator-profile-visibility"><input name="public" type="checkbox"/> Show my profile publicly</label><div class="creator-profile-actions fl-actions"><button class="button primary" type="submit">Save profile</button><a id="creator-profile-link" class="fl-btn" hidden>View public profile</a></div><p id="creator-profile-status" class="fl-status" role="status" aria-live="polite"></p></form></section>
      </section>
      <section id="account-panel-settings" role="tabpanel" aria-labelledby="account-tab-settings" class="fl-tabpanel" hidden>
        <div class="fl-settings">
          <div class="fl-card fl-panel-pad fl-setting"><div><h3>Notifications</h3><p>Choose which activity sends you an alert.</p></div><a class="fl-btn" href="/notifications">Manage notifications</a></div>
          <div class="fl-card fl-panel-pad fl-setting"><div><h3>Inbox</h3><p>Messages from other creators.</p></div><a class="fl-btn" href="/inbox">Open inbox</a></div>
          <section id="weekly-email" class="fl-card fl-panel-pad fl-setting" hidden><div><h3>Weekly email</h3><p>Get new projects by email. Unsubscribe anytime.</p><p id="weekly-status" class="fl-status" role="status" aria-live="polite"></p></div><button class="fl-btn" id="weekly-toggle" type="button">Get weekly emails</button></section>
          <div class="fl-card fl-panel-pad fl-setting"><div><h3>Password</h3><p>Send a reset link to your account email.</p><p id="account-reset-status" class="fl-status" role="status" aria-live="polite"></p></div><button class="fl-btn" id="account-reset-link" type="button">Email me a reset link</button></div>
        </div>
      </section>
    </div>
  </section>
  <script>import '../scripts/project-account.js';</script>
</Platform>
