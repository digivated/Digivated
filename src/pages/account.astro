---
import Platform from '../layouts/Platform.astro';
import '../styles/project-account.css';
---
<Platform title="Your Projects" description="Sign in to follow your Digivated project submissions and read private review feedback.">
  <header class="page-intro"><p class="eyebrow">YOUR DIGIVATED ACCOUNT</p><h1>Your projects, in one place.</h1><p class="lede">Sign in with your email and password to see your submissions and any private feedback from our review.</p></header>
  <section class="project-account-card" aria-label="Project account">
    <p id="account-state" role="status" aria-live="polite">Connecting to account sign-in…</p>
    <form id="account-password-reset" class="login-panel" hidden>
      <label for="account-new-password">New password</label>
      <input id="account-new-password" name="password" type="password" autocomplete="new-password" minlength="10" required aria-describedby="account-password-help"/>
      <p id="account-password-help">Use at least 10 characters.</p>
      <label for="account-confirm-password">Confirm new password</label>
      <input id="account-confirm-password" name="confirmation" type="password" autocomplete="new-password" minlength="10" required/>
      <button class="button primary" type="submit">Save new password</button>
    </form>
    <div id="account-sign-in" class="account-actions" hidden><a class="button primary" href="/login">Log in or sign up</a><a class="button" href="/discover?view=featured">Browse featured projects</a></div>
    <div id="account-signed-in" hidden><p>Signed in as <strong id="account-email"></strong></p><div class="account-actions"><a class="button primary" href="/submit-project">Submit a project</a><a class="button" href="/creators">Explore creators</a><button class="button" id="account-sign-out" type="button">Sign out</button></div><section class="creator-profile-editor" aria-labelledby="creator-profile-title"><p class="eyebrow">YOUR CREATOR SPACE</p><h2 id="creator-profile-title">Your profile</h2><p>A simple place for builders to find you and your published work. Your email and review notes stay private.</p><form id="creator-profile-form"><label>Display name<input name="name" maxlength="60" required placeholder="Your name or studio"/></label><label>Short bio<textarea name="bio" maxlength="240" rows="3" placeholder="What are you building?"></textarea></label><label>Website <span class="quiet">(optional)</span><input name="website" type="url" maxlength="300" placeholder="https://your-site.com"/></label><label>Social profile <span class="quiet">(optional)</span><input name="social" type="url" maxlength="300" placeholder="https://x.com/yourname"/></label><label class="creator-profile-visibility"><input name="public" type="checkbox"/> Show my profile publicly</label><div class="creator-profile-actions"><button class="button primary" type="submit">Save profile</button><a id="creator-profile-link" class="button" href="/creator" hidden>View public profile</a></div><p id="creator-profile-status" role="status" aria-live="polite"></p></form></section><section class="creator-following-feed"><h2>From creators you follow</h2><p id="creator-feed-status" class="quiet">Loading recent projects…</p><div id="creator-feed" class="creator-projects"></div><a href="/creators">Explore creators →</a></section><h2>My submissions</h2><div id="account-submissions"></div><section id="weekly-email" hidden><h2>Weekly email</h2><p>Get a short email when new projects appear on Digivated. Optional, and you can unsubscribe anytime.</p><button class="button" id="weekly-toggle" type="button">Get weekly emails</button><p id="weekly-status" role="status" aria-live="polite"></p></section></div>
  </section>
  <script>import '../scripts/project-account.js';</script>
</Platform>
