---
import Platform from '../layouts/Platform.astro';
import '../styles/saved.css';
---
<Platform title="Saved" description="Keep independent projects and useful resources together in your own private browser collections.">
<header class="page-intro saved-intro"><h1>Saved items</h1><p class="lede">Your collections are saved in this browser.</p></header>
<section id="saved-root" class="saved-workspace" aria-label="Your saved collections">
<div class="saved-sidebar"><div class="saved-sidebar-heading"><h2>Collections</h2></div><nav id="saved-folders" aria-label="Your collections"></nav><button class="button" id="new-collection"><span aria-hidden="true">＋</span> New collection</button>
<details class="saved-backup"><summary>Back up your collections</summary><p>Collections live in this browser and don’t sync. Download a backup before you clear browser data. You can import it in any browser.</p><button class="button" id="export-collections">Download backup</button><label class="button import-label">Import backup<input id="import-collections" type="file" accept="application/json,.json" aria-label="Import backup"/></label><p>Importing adds to your collections without replacing them.</p></details></div>
<div class="saved-content"><div class="saved-content-heading"><div><h2 id="saved-heading" tabindex="-1" class="sr-only">Collection items</h2><p id="saved-count" class="quiet"></p></div><div class="actions saved-manage"><button class="button" id="rename-collection" hidden>Rename collection</button><button class="button" id="delete-collection" hidden>Delete collection</button></div></div>
<div class="browse-controls"><label>Search saved items<input type="search" id="saved-search" placeholder="Find something you saved…"/></label><label>Item type<select id="saved-type"><option value="">All items</option><option value="project">Projects</option><option value="resource">Resources</option></select></label></div>
<div class="saved-feedback"><p id="saved-status" role="status" aria-live="polite"></p><button class="button" id="refresh-saved">Refresh items</button></div>
<div id="saved-empty-panel" class="saved-empty-panel" hidden><h3 id="saved-empty-title">Make room for your next idea.</h3><p id="saved-empty"></p><div class="actions"><a class="button primary" href="/discover">Explore projects</a><a class="button" href="/resources">Browse resources</a><button class="button" id="clear-saved-filters" hidden>Clear filters</button></div></div><div id="saved-items" class="resource-grid"></div></div></section>
<dialog id="collection-manager" class="collection-dialog" aria-labelledby="collection-manager-title"><h2 id="collection-manager-title">New collection</h2><form id="collection-manager-form"><label>Name<input id="collection-name" maxlength="60" required placeholder="e.g. Portfolio inspiration" aria-describedby="collection-name-help"/></label><p id="collection-name-help" class="quiet">Choose a name you’ll recognize later. Up to 60 characters.</p><p id="collection-manager-status" role="status"></p><div class="actions"><button class="button primary" type="submit">Save collection</button><button class="button" type="button" id="cancel-collection">Cancel</button></div></form></dialog><noscript>Enable JavaScript to use browser collections.</noscript></Platform>
