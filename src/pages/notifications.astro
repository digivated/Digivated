---
import Platform from '../layouts/Platform.astro';
import UiIcon from '../components/UiIcon.astro';
import '../styles/notifications.css';
---
<Platform title="Notifications" description="Your Digivated activity, on your terms.">
  <section class="notifications-page fl-notify" aria-labelledby="notifications-title">
    <header class="notifications-heading"><div><p class="eyebrow">YOUR ACTIVITY</p><h1 id="notifications-title">Notifications</h1><p>Launch updates, replies, follows, messages, and feedback in one place.</p></div><a href="/account">Dashboard <span aria-hidden="true">→</span></a></header>
    <div id="notifications-auth" class="notifications-auth fl-card fl-panel-pad" role="status"><p>Checking your account…</p><a class="button primary" href="/login?next=%2Fnotifications" hidden>Sign in</a></div>
    <div id="notifications-main" class="fl-notify-main" hidden>
      <section class="notifications-feed fl-card" aria-labelledby="notifications-feed-title">
        <header class="fl-notify-head"><div><h2 id="notifications-feed-title">Recent activity</h2><p id="notifications-count">Your updates will appear here.</p></div><div class="notifications-feed-actions"><button id="notifications-read-all" class="fl-btn fl-btn-small" type="button" hidden>Mark all read</button><button id="notifications-clear" class="fl-link" type="button" hidden>Clear history</button></div></header>
        <div class="fl-tabs fl-notify-filter" role="tablist" aria-label="Filter notifications"><button type="button" role="tab" aria-selected="true" data-notification-filter="all">All</button><button type="button" role="tab" aria-selected="false" tabindex="-1" data-notification-filter="unread">Unread</button></div>
        <div id="notifications-items" class="notifications-items" aria-live="polite"></div>
      </section>
      <section class="notifications-feed notifications-approvals fl-card" aria-labelledby="notifications-approvals-title">
        <header class="fl-notify-head"><div><h2 id="notifications-approvals-title">Your live projects</h2><p id="notifications-approval-status">Checking your live projects…</p></div><a class="fl-link" href="/account">Launch status →</a></header>
        <div id="notifications-approvals" class="notifications-items"></div>
      </section>
      <section class="fl-card fl-panel-pad fl-notify-settings" aria-labelledby="notifications-preferences-title">
        <div class="notifications-preferences"><div class="notifications-preferences-copy"><span class="notifications-setting-icon"><UiIcon name="bell" size={21}/></span><div><h2 id="notifications-preferences-title">Activity notifications</h2><p>Launch and approval updates always arrive. Choose which activity alerts you also want.</p></div></div><label class="notifications-master"><input type="checkbox" id="notifications-enabled"/><span class="notifications-switch" aria-hidden="true"></span><span class="sr-only">Turn on activity notifications</span></label></div>
        <details class="notifications-choices" open><summary>Choose activity</summary><div class="notifications-choice-list"><label><span><strong>Replies</strong><small>When someone replies to your post.</small></span><input type="checkbox" data-notification-pref="reply"/></label><label><span><strong>New followers</strong><small>When a creator follows you.</small></span><input type="checkbox" data-notification-pref="follow"/></label><label><span><strong>Messages</strong><small>When a creator sends you a message.</small></span><input type="checkbox" data-notification-pref="message"/></label><label><span><strong>Project feedback</strong><small>When someone leaves feedback on a project you submitted.</small></span><input type="checkbox" data-notification-pref="feedback"/></label></div></details>
        <p id="notifications-settings-status" class="notifications-settings-status fl-status" role="status" aria-live="polite"></p>
      </section>
    </div>
  </section>
  <script>import '../scripts/notifications.js';</script>
</Platform>
