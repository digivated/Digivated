---
import Platform from '../layouts/Platform.astro';
import UiIcon from '../components/UiIcon.astro';
import SettingsMasthead from '../components/SettingsMasthead.astro';
import '../styles/notifications.css';

const activityChoices = [
  ['feedback', 'Project comments', 'New comments on your projects.'],
  ['reply', 'Replies', 'Replies to your comments and threads.'],
  ['upvote', 'Upvotes', 'Grouped by project, thread, or comment each day.'],
  ['launch', 'Launch reminders', 'Products you watch and makers you follow.'],
  ['award', 'Weekly podium', 'An in-app alert when your launch finishes in the top three.'],
  ['follow', 'New followers', 'When someone follows your public profile.'],
];
---
<Platform title="Notifications" description="See your Digivated activity and manage your notification settings.">
  <section class="notifications-page" aria-labelledby="notifications-title">
    <SettingsMasthead title="Notifications" id="notifications-title" level="h1" description="Launch updates and activity.">
      <a href="/account?tab=settings"><UiIcon name="arrow-left" size={16}/> Account settings</a>
    </SettingsMasthead>

    <div id="notifications-auth" class="notifications-auth notifications-card" role="status">
      <p>Checking your account…</p>
      <a class="button primary" href="/login?next=%2Fnotifications" hidden>Sign in</a>
    </div>

    <div id="notifications-main" class="notifications-layout" hidden>
      <nav class="notifications-jumps" aria-label="Notifications sections">
        <a href="#notification-activity"><UiIcon name="clock" size={17}/> Activity</a>
        <a href="#notification-preferences"><UiIcon name="sliders" size={17}/> Preferences</a>
      </nav>
      <div class="notifications-activity">
        <section id="notification-activity" class="notifications-feed notifications-card" aria-labelledby="notifications-feed-title">
          <header class="notifications-section-head">
            <div><h2 id="notifications-feed-title">Recent activity</h2><p id="notifications-count">Your updates will appear here.</p></div>
            <div class="notifications-feed-actions">
              <button id="notifications-read-all" class="fl-btn" type="button" hidden>Mark all read</button>
              <button id="notifications-clear" class="fl-btn" type="button" hidden>Clear history</button>
            </div>
          </header>
          <div class="notifications-filter" role="tablist" aria-label="Filter notifications">
            <button id="notifications-all-tab" type="button" role="tab" aria-controls="notifications-items" aria-selected="true" data-notification-filter="all">All</button>
            <button id="notifications-unread-tab" type="button" role="tab" aria-controls="notifications-items" aria-selected="false" tabindex="-1" data-notification-filter="unread">Unread</button>
          </div>
          <p id="notifications-feed-status" class="notifications-status" role="status"></p>
          <div id="notifications-items" class="notifications-items" role="tabpanel" aria-labelledby="notifications-all-tab" tabindex="0" aria-live="polite"></div>
        </section>

        <section class="notifications-approvals notifications-card" aria-labelledby="notifications-approvals-title">
          <header class="notifications-section-head">
            <div><h2 id="notifications-approvals-title">Your live projects</h2><p id="notifications-approval-status">Checking your live projects…</p></div>
            <a class="fl-link" href="/account">Your Projects <UiIcon name="arrow" size={15}/></a>
          </header>
          <div id="notifications-approvals" class="notifications-items"></div>
        </section>
      </div>

      <section id="notification-preferences" class="notifications-settings notifications-card" aria-labelledby="notifications-preferences-title">
        <header class="notifications-settings-head">
          <span class="notifications-setting-icon" aria-hidden="true"><UiIcon name="bell" size={20}/></span>
          <div><h2 id="notifications-preferences-title">Notification settings</h2><p>Choose what reaches you.</p></div>
        </header>
        <div class="notifications-choice-list">
          <label class="notifications-choice notifications-master">
            <span><strong>Activity alerts</strong><small>Pause optional alerts without losing your choices.</small></span>
            <input type="checkbox" id="notifications-enabled" role="switch" aria-label="Activity alerts" aria-describedby="notification-service-updates"/>
          </label>
          <fieldset class="notifications-options">
            <legend>Activity</legend>
            {activityChoices.map(([key, label, description]) => <label class="notifications-choice">
              <span><strong>{label}</strong><small id={`notification-help-${key}`}>{description}</small></span>
              <input type="checkbox" data-notification-pref={key} aria-label={label} aria-describedby={`notification-help-${key}`}/>
            </label>)}
          </fieldset>
          <fieldset class="notifications-options">
            <legend>Email</legend>
            <label class="notifications-choice">
              <span><strong>Email me activity alerts</strong><small>Send eligible activity alerts to your verified email.</small></span>
              <input type="checkbox" data-notification-pref="emailEnabled" aria-label="Email me activity alerts"/>
            </label>
          </fieldset>
        </div>
        <div class="notifications-service" id="notification-service-updates">
          <UiIcon name="check" size={17}/>
          <p><strong>Project updates stay on.</strong> Badge confirmation and go-live updates appear here. Project status and podium emails are sent separately.</p>
        </div>
        <p id="notifications-settings-status" class="notifications-status" role="status"></p>
      </section>
    </div>
  </section>
  <script>import '../scripts/notifications.js';</script>
</Platform>
