---
import Platform from '../layouts/Platform.astro';
import { BADGE_HEIGHT, BADGE_STYLES, BADGE_WIDTH, badgeSnippet } from '../../server/badge-snippets.mjs';
import { renderBadge } from '../../server/badge-render.mjs';
const example = 'YOUR_PROJECT_ID';
const src = (style: string) => 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(renderBadge(style, 482));
---
<Platform title="Embed badges" description="Add a Featured on Digivated badge to your website. It shows your live upvotes and links to your project listing.">
  <header class="page-intro"><h1>Embed badges</h1><p class="lede">Link to your listing, show live upvotes, and qualify for a free launch.</p></header>
  <section class="fl-badges-page" aria-label="Badge styles">
    <p class="fl-badges-intro"><a class="button primary" href="/dashboard#account-submissions">Get your badge code</a></p>
    <div class="fl-badges" data-badge-examples>
      {BADGE_STYLES.filter(style => style.key !== 'text').map(style => (
        <article class="fl-badge-card" data-badge-style={style.key}>
          <div class={`fl-badge-stage is-${style.key}`}><img src={src(style.key)} width={BADGE_WIDTH} height={BADGE_HEIGHT} alt={`${style.label} badge example`} /></div>
          <div class="fl-badge-bar"><div>{style.key === 'dark' && <em class="fl-badge-tag">Recommended</em>}<strong>{style.label}</strong><span>{style.note}</span></div></div>
          <details class="fl-badge-more fl-badge-code-details"><summary>Example embed code</summary><pre class="fl-badge-code"><code>{badgeSnippet(example, style.key)}</code></pre></details>
        </article>
      ))}
      <details class="fl-badge-more"><summary>Use a text badge</summary>
        <article class="fl-badge-card" data-badge-style="text">
          <div class="fl-badge-stage is-text"><span class="fl-badge-preview">[ listed on Digivated ]</span></div>
          <div class="fl-badge-bar"><div><strong>Text link</strong><span>No image, just a link</span></div></div>
          <details class="fl-badge-more fl-badge-code-details"><summary>Example embed code</summary><pre class="fl-badge-code"><code>{badgeSnippet(example, 'text')}</code></pre></details>
        </article>
      </details>
    </div>
    <p class="fl-badges-notes">Any style verifies. Keep the badge visible on the page you submitted.</p>
  </section>
</Platform>
