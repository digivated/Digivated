---
import Admin from '../../layouts/Admin.astro';
import '../../styles/admin-news.css';
---
<Admin>
  <section class="news-owner-signin" id="news-owner-signin">
    <p class="eyebrow">News desk</p><h1>Owner access</h1>
    <p id="news-signin-copy">Checking your dashboard session…</p>
    <a class="button primary" href="/admin">Sign in to the dashboard</a>
    <p class="quiet">After signing in, return to this page to review News.</p>
  </section>
  <section class="news-owner" id="news-owner" hidden>
    <header class="news-owner-intro"><div><p class="eyebrow">Digivated News</p><h1>News desk</h1><p>Review source evidence, correct stories, and manage publication.</p></div><div class="news-owner-links"><a href="/admin">Dashboard</a><a href="/news" target="_blank" rel="noopener noreferrer">View News ↗</a></div></header>
    <section class="news-worker" aria-labelledby="news-worker-title"><div><h2 id="news-worker-title">Publishing checks</h2><p id="news-worker-status">Loading pipeline status…</p><p class="quiet" id="news-worker-checked"></p></div><div class="news-worker-actions"><button class="button" type="button" id="news-worker-pause" disabled>Pause checks</button><button class="button primary" type="button" id="news-worker-run" disabled>Check sources now</button></div><details class="news-worker-report"><summary>Latest source checks</summary><div id="news-worker-report"></div></details></section>
    <div class="news-owner-toolbar"><label>Status<select id="news-owner-filter"><option value="review">Needs review</option><option value="published">Published</option><option value="removed">Removed</option><option value="all">All stories</option></select></label><label class="news-owner-search">Search loaded stories<input type="search" id="news-owner-search" placeholder="Headline or source"/></label><button type="button" class="button" id="news-owner-refresh">Refresh</button></div>
    <p class="news-owner-status" id="news-owner-status" role="status" aria-live="polite"></p>
    <div class="news-owner-list" id="news-owner-list"></div>
    <button class="button" type="button" id="news-owner-more" hidden>Load more</button>
  </section>
  <dialog class="news-review-dialog" id="news-review-dialog" aria-labelledby="news-review-title"><header class="news-review-heading"><div><p class="eyebrow">Story review</p><h2 id="news-review-title">Review story</h2></div><button class="button small" type="button" id="news-review-close">Close</button></header><p class="news-review-status" id="news-review-status" role="status" aria-live="polite"></p><div class="news-review-body"><section class="news-source-evidence" aria-labelledby="news-evidence-title"><h3 id="news-evidence-title">Source and verification</h3><div id="news-review-evidence"></div></section><form id="news-review-form"><label>Source publication time (your local time)<input id="news-review-source-time" type="datetime-local" step="1"/></label><label>Headline<input id="news-review-headline" name="headline" required maxlength="220"/></label><label>Member summary<textarea id="news-review-summary" name="summary" maxlength="900" rows="5"></textarea></label><div class="news-review-fields"><label>Category<select id="news-review-category" name="category"><option value="ai-tech">AI / Tech</option><option value="markets">Markets</option><option value="security">Security</option></select></label><label>Label<select id="news-review-classification" name="classification"><option value="update">Update</option><option value="breaking">Breaking</option></select></label><label>Status<select id="news-review-state" name="status"><option value="review">Needs review</option><option value="published">Published</option><option value="removed">Removed</option></select></label></div><p class="quiet">Breaking is reserved for significant, verified current events. An older story may be saved as an Update.</p><label>Review or correction note<textarea id="news-review-note" name="reviewNote" rows="3" maxlength="1200" required placeholder="What did you verify or change? This stays in the private audit record."></textarea></label><label class="news-source-confirm"><input id="news-review-confirm" name="verificationConfirmed" type="checkbox"/><span>I opened the original source and confirmed its claims and publication time support this headline and summary.</span></label><p class="quiet" id="news-publish-help">Confirm the source and leave a note before publishing.</p><div class="news-review-actions"><button class="button primary" id="news-review-save" type="submit">Save story</button><button class="button" id="news-review-remove" type="button">Remove from News</button></div></form><details class="news-audit"><summary>Publication and correction history</summary><div id="news-review-audit"></div></details></div></dialog>
  <script>import '../../scripts/admin-news.js';</script>
</Admin>
