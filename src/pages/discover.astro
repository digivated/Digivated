---
import Platform from '../layouts/Platform.astro';
import FeedbackPoints from '../components/FeedbackPoints.astro';
import '../styles/project-wall.css';
import '../styles/all-time-directory.css';
---
<Platform title="Product directory" description="Find independent products by category, or search by product or maker.">
  <div class="dg-dir" data-directory>
    <section class="dg-hero" aria-labelledby="dg-dir-title">
      <div class="dg-hero-copy">
        <h1 id="dg-dir-title">Product directory</h1>
        <p class="dg-hero-lede">Find independent products by category, name or maker.</p>
      </div>
    </section>

    <div class="dg-dir-controls">
      <div class="dg-dir-searchrow">
        <label class="dg-dir-search"><span class="sr-only">Search products or makers</span><input type="search" data-dir-search placeholder="Search products or makers" autocomplete="off" enterkeyhint="search"/></label>
        <div class="dg-dir-collection" role="group" aria-label="Project collection"><button type="button" data-dir-collection="all" aria-pressed="true">All</button><button type="button" data-dir-collection="featured" aria-pressed="false">Members</button></div>
        <button type="button" class="dg-btn dg-dir-surprise" data-dir-surprise>Surprise me</button>
      </div>
      <div class="dg-dir-filters">
        <label>Sort by <select data-dir-sorts></select></label>
        <label>Category <select data-dir-chips><option value="">All categories</option></select></label>
      </div>
    </div>

    <section id="project-wall" aria-labelledby="dg-dir-list-title">
      <header class="dg-list-head"><h2 id="dg-dir-list-title"><span class="dg-list-title">Browse products</span></h2></header>
      <p class="dg-dir-needs" data-dir-needs hidden>These products have the least feedback. Visit one for at least 20 seconds, then come back and leave a helpful comment to earn points. <a href="/points">How points work →</a></p>
      <ol class="dg-dir-list dg-list-rows" data-dir-list aria-label="Directory products">
        {Array.from({ length: 6 }, () => <li class="dg-row is-loading" aria-hidden="true"><span class="dg-logo"></span><span class="dg-main"></span></li>)}
      </ol>
      <p class="dg-dir-status" data-dir-status role="status" hidden></p>
      <div class="dg-dir-foot"><small data-dir-shown aria-live="polite"></small><button type="button" class="dg-more" data-dir-more hidden>Show more</button></div>
      <p class="sr-only" aria-live="polite" data-dir-live></p>
      <noscript><p>JavaScript is needed to browse projects.</p></noscript>
    </section>

    <section class="dg-dir-overview" data-section-reveal aria-labelledby="dg-dir-overview-title">
      <h2 id="dg-dir-overview-title">Directory activity</h2>
      <ul class="dg-dir-stats" aria-label="Directory totals">
        <li><strong data-dir-stat="projects">—</strong><span>products</span></li>
        <li><strong data-dir-stat="categories">—</strong><span>categories</span></li>
        <li><strong data-dir-stat="upvotes">—</strong><span>upvotes</span></li>
        <li><strong data-dir-stat="comments">—</strong><span>comments</span></li>
      </ul>
      <nav class="dg-dir-launchnav" aria-label="Launches"><a href="/#this-week">This week’s launches →</a><a href="/#last-week">Last week →</a></nav>
    </section>
    <FeedbackPoints variant="strip" cta="/discover?sort=needs" ctaLabel="Show products that need feedback"/>
  </div>
</Platform>
<script>import '../scripts/all-time-directory.js'; import '../scripts/visit-feedback.js';</script>
