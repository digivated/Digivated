---
import Platform from '../layouts/Platform.astro';
import UiIcon from '../components/UiIcon.astro';
import '../styles/project-wall.css';
import '../styles/all-time-directory.css';
---
<Platform title="Product directory" description="Find independent products by category, or search by product or maker.">
  <div class="dg-dir" data-directory>
    <section class="dg-hero" aria-labelledby="dg-dir-title">
      <div class="dg-hero-copy">
        <h1 id="dg-dir-title">Product directory</h1>
      </div>
    </section>

    <div class="dg-dir-controls" id="directory-filters">
      <div class="dg-dir-searchrow">
        <label class="dg-dir-search"><UiIcon name="search" size={18}/><span class="sr-only">Search products or makers</span><input type="search" data-dir-search placeholder="Search products or makers" maxlength="120" autocomplete="off" enterkeyhint="search"/></label>
        <div class="dg-dir-collection" role="group" aria-label="Project collection"><button type="button" data-dir-collection="all" aria-pressed="true">All</button><button type="button" data-dir-collection="featured" aria-pressed="false">Members</button></div>
        <button type="button" class="dg-btn dg-dir-surprise" data-dir-surprise>Surprise me</button>
      </div>
      <div class="dg-dir-filters">
        <label>Sort by <select data-dir-sorts></select></label>
        <label>Category <select data-dir-chips><option value="">All categories</option></select></label>
      </div>
    </div>

    <section id="project-wall" aria-labelledby="dg-dir-list-title">
      <h2 id="dg-dir-list-title" class="sr-only">Products</h2>
      <p class="dg-dir-needs" data-dir-needs hidden>Visit for 20 seconds and leave feedback to earn points.</p>
      <ol class="dg-dir-list dg-list-rows dg-project-list" data-dir-list aria-label="Directory products">
        {Array.from({ length: 6 }, () => <li class="dg-row is-loading" aria-hidden="true"><span class="dg-logo"></span><span class="dg-main"></span></li>)}
      </ol>
      <p class="dg-dir-status" data-dir-status role="status" hidden></p>
      <div class="dg-dir-foot"><small data-dir-shown aria-live="polite"></small><button type="button" class="dg-more" data-dir-more hidden>Show more</button></div>
      <p class="sr-only" aria-live="polite" data-dir-live></p>
      <noscript><p>JavaScript is needed to browse projects.</p></noscript>
    </section>

  </div>
</Platform>
<script>import '../scripts/all-time-directory.js'; import '../scripts/visit-feedback.js';</script>
