---
import Platform from '../../layouts/Platform.astro';
import ThreadsSidebar from '../../components/ThreadsSidebar.astro';
import UiIcon from '../../components/UiIcon.astro';
---
<Platform showBreadcrumb={false} title="Threads" description="Ask questions, get feedback and talk about building with other independent makers on Digivated Threads." canonicalPath="/threads">
  <div class="dg-forum" data-threads-page="list">
    <header class="dg-forum-header">
      <div class="dg-forum-heading">
        <div class="dg-forum-titleline">
          <span class="dg-forum-mark" data-forum-mark aria-hidden="true"><UiIcon name="comment" size={22}/></span>
          <h1 id="dg-forum-title" data-forum-title>Threads</h1>
        </div>
        <p data-forum-description>Talk shop with other builders. Share, ask, get feedback.</p>
      </div>
      <div class="dg-forum-tools">
        <form class="dg-forum-search" action="/threads" method="get" role="search">
          <label class="sr-only" for="dg-forum-search">Search all threads</label>
          <span class="dg-forum-field"><span class="dg-forum-search-icon" aria-hidden="true"><UiIcon name="search" size={16}/></span><input id="dg-forum-search" name="q" type="search" placeholder="Search threads" maxlength="80" autocomplete="off"/></span>
          <button class="dg-btn" type="submit">Search</button>
        </form>
        <a class="dg-btn dg-btn-primary dg-forum-new" href="/threads/new" data-forum-new><UiIcon name="plus" size={16}/>Start a thread</a>
      </div>
    </header>
    <ThreadsSidebar showSearch={false}/>
    <section class="dg-forum-main" aria-labelledby="dg-forum-title">
      <section class="dg-today" data-today hidden aria-label="Today on Digivated"></section>
      <div class="dg-forum-toolbar" data-forum-toolbar>
        <p class="dg-forum-total" data-forum-total></p>
        <div class="dg-forum-sort" role="group" aria-label="Sort threads">
          <button type="button" data-sort="trending" aria-pressed="true"><UiIcon name="chart" size={14}/>Trending</button>
          <button type="button" data-sort="new" aria-pressed="false"><UiIcon name="sparkle" size={14}/>New</button>
          <button type="button" data-sort="top" aria-pressed="false"><UiIcon name="like" size={14}/>Top</button>
        </div>
      </div>
      <p class="dg-forum-status" data-forum-status role="status">Loading threads…</p>
      <div class="dg-skeleton-list" data-forum-skeleton aria-hidden="true">
        <span data-lattice data-label="Loading threads"></span>
        {[0, 1, 2, 3].map(() => <div class="dg-skel-row"><span class="dg-skel is-short"></span><span class="dg-skel is-title"></span><span class="dg-skel is-wide"></span><span class="dg-skel is-mid"></span></div>)}
      </div>
      <div class="dg-starters" data-forum-empty hidden></div>
      <ol class="dg-thread-list" data-thread-list></ol>
      <button type="button" class="dg-more" data-forum-more hidden>Load more</button>
    </section>
  </div>
  <script>import '../../scripts/lattice-loader.js'; import '../../scripts/threads.js';</script>
</Platform>
