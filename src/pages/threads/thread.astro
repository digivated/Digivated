---
import Platform from '../../layouts/Platform.astro';
import ThreadsSidebar from '../../components/ThreadsSidebar.astro';
// Served for /threads/<slug> through a rewrite; the thread loads from its URL.
---
<Platform showBreadcrumb={false} title="Thread" description="A discussion on Digivated Threads." noindex={false}>
  <div class="dg-forum dg-forum-secondary" data-threads-page="thread">
    <article class="dg-forum-main dg-thread-page" aria-live="polite">
      <p class="dg-forum-status" data-thread-status role="status">Loading thread…</p>
      <div class="dg-thread-skeleton" data-thread-skeleton aria-hidden="true">
        <span class="dg-skel is-short"></span><span class="dg-skel is-title"></span><span class="dg-skel is-wide"></span><span class="dg-skel is-wide"></span><span class="dg-skel is-mid"></span>
      </div>
      <div data-thread-root hidden>
        <p class="dg-thread-crumbs"><a href="/threads">Threads</a> <span aria-hidden="true">/</span> <a data-thread-forum href="/threads"></a></p>
        <div class="dg-thread-news" data-thread-news hidden></div>
        <div class="dg-thread-card">
          <h1 data-thread-title></h1>
          <p class="dg-thread-byline" data-thread-byline></p>
          <div class="dg-thread-body" data-thread-body></div>
          <div class="dg-thread-react" data-thread-react hidden></div>
          <div class="dg-thread-actions" data-thread-actions></div>
        </div>
      </div>
      <section class="dg-thread-discussion" data-thread-discussion hidden aria-label="Replies"></section>
    </article>
    <ThreadsSidebar active="" showStart/>
  </div>
  <script>import '../../scripts/threads.js';</script>
</Platform>
