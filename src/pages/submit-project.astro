---
import Platform from '../layouts/Platform.astro';
import FreeLaunchGuide from '../components/FreeLaunchGuide.astro';
import { projectPricingOptions } from '../lib/project-pricing.mjs';
import '../styles/submission-flow.css';

// Labels are for the submission form. Values are the existing directory categories.
const submissionCategoryGroups = [
  {
    label: 'Build & create',
    options: [
      ['Developer Tools', 'Coding & Dev Tools'],
      ['Design', 'Design & UX'],
      ['Creator Tools', 'Content Creation'],
      ['Digital Products', 'Templates & Downloads'],
    ],
  },
  {
    label: 'Work & learn',
    options: [
      ['Business', 'Business & Marketing'],
      ['Productivity', 'Productivity & Tasks'],
      ['Education', 'Education & Learning'],
    ],
  },
];
---
<Platform title="Submit Your Project" description="Share what you built. Choose a free launch with a website badge, Instant Publishing, or a Membership Spotlight.">
  <header class="page-intro submission-intro">

    <h1>Submit a project.</h1>
    <p class="lede">Add your details, pick how to launch, and track every step from your dashboard.</p>
  </header>

  <FreeLaunchGuide />

  <div class="submission-layout submission-workspace">
    <form class="submission-form" id="project-form" action="/api/submissions" method="post">
      <div id="submission-account-callout" class="submission-account-callout">
        <strong>Create a free account to submit</strong>
        <p>Sign in to submit, track your review, and see private feedback.</p>
        <div class="submission-account-actions"><a class="button primary" href="/login?mode=signup&amp;next=%2Fsubmit-project">Create an account</a><a href="/login?next=%2Fsubmit-project">Already have one? Sign in</a></div>
      </div>
      <p id="submission-account-status" class="submission-account-status" role="status" aria-live="polite" hidden></p>

      <div id="instant-launch-resume" class="submission-review" hidden><h2>Finish publishing</h2><p>Use the same email at checkout as on your Digivated account. After paying, return here and verify your purchase.</p><div class="submission-account-actions"><a id="instant-launch-checkout" class="button primary" target="_blank" rel="noopener">Open checkout ↗</a><button id="instant-launch-verify" class="button" type="button">Verify payment and publish</button></div><p id="instant-launch-status" role="status" aria-live="polite"></p><a id="instant-launch-listing" hidden>View your live project →</a></div>
      <div id="submission-details" hidden>
      <ol class="fl-progress" id="submission-progress" aria-label="Form progress">
        <li data-progress="sub-step-details"><a href="#sub-step-details"><span class="fl-progress-mark" aria-hidden="true">[1]</span> Project</a></li>
        <li data-progress="sub-step-logo"><a href="#sub-step-logo"><span class="fl-progress-mark" aria-hidden="true">[2]</span> Logo</a></li>
        <li data-progress="sub-step-you"><a href="#sub-step-you"><span class="fl-progress-mark" aria-hidden="true">[3]</span> About you</a></li>
        <li data-progress="sub-step-launch"><a href="#sub-step-launch"><span class="fl-progress-mark" aria-hidden="true">[4]</span> Launch</a></li>
      </ol>


      <fieldset id="sub-step-details">
        <legend><span class="submission-step-label">01 · Project details</span>Tell us about your project</legend>
        <p class="field-help">Import a name and description from your website. You can edit both.</p><label>Project name<input name="name" placeholder="Your product name" maxlength="120" required/></label>
        <label>Project URL<input name="url" type="url" placeholder="https://your-project.com" maxlength="500" required/></label>
        <button type="button" id="project-import">[ Import website details ]</button><p id="project-import-status" role="status"></p>
        <label>Project description<textarea name="description" rows="4" minlength="20" maxlength="600" required placeholder="What does it do, and who is it for?"></textarea><span class="field-help">20–600 characters. Start with what it does, then who it helps. Avoid hashtags and promotional slogans.</span></label>
        <label>
          <span id="project-category-label">Category</span>
          <span class="submission-category-control">
            <select name="category" aria-labelledby="project-category-label" aria-describedby="project-category-help" required>
              <option value="">Choose a category</option>
              <option value="AI">AI Tools</option>
              {submissionCategoryGroups.map(({ label, options }) => (
                <optgroup label={label}>
                  {options.map(([value, text]) => <option value={value}>{text}</option>)}
                </optgroup>
              ))}
              <option value="Other">Other</option>
            </select>
          </span>
          <span id="project-category-help" class="field-help">Choose what your project mainly helps people do.</span>
        </label>
        <fieldset class="submission-pricing" aria-describedby="project-pricing-help">
          <legend>Project pricing <span class="quiet">(optional)</span></legend>
          <p id="project-pricing-help" class="field-help">Choose how people pay to use your project.</p>
          <div class="submission-pricing-options">
            <label><input type="radio" name="pricing" value="" checked/><span>Skip for now</span></label>
            {projectPricingOptions.filter(option => option !== 'Open source').map(option => (
              <label><input type="radio" name="pricing" value={option}/><span>{option === 'Freemium' ? 'Free + paid plans' : option}</span></label>
            ))}
          </div>
        </fieldset>
      </fieldset>

      <fieldset id="sub-step-logo">
        <legend><span class="submission-step-label">02 · Logo</span>Project logo</legend>
        <label class="submission-upload">Project logo<input name="image" id="project-image" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="project-image-help" required/><span class="field-help" id="project-image-help">Required. Upload your project’s logo, not a website screenshot. JPG, PNG, or WebP, up to 10 MB. A square PNG or WebP with a transparent background works best. We preserve the full logo in a consistent square frame.</span></label>
        <div id="project-image-preview" class="submission-image-preview" hidden><img alt="Selected project logo preview"/><span id="project-image-name"></span></div>
      </fieldset>

      <fieldset id="sub-step-you">
        <legend><span class="submission-step-label">03 · Creator details</span>About you</legend>
        <p class="submission-section-help">We’ll use these details to review your submission. Your email stays private.</p>
        <div class="form-row"><label>Creator name<input name="creator" placeholder="Your name" autocomplete="name" maxlength="100" required/></label><label>Email<input name="email" placeholder="you@example.com" type="email" autocomplete="email" maxlength="254" required/><span class="field-help">Use the email linked to your account.</span></label></div>
        <label>Social handle <span class="quiet">(optional)</span><input name="social" maxlength="200" placeholder="@yourhandle — include the platform"/></label>
        <label>Notes for the review <span class="quiet">(optional)</span><textarea name="notes" rows="3" maxlength="2000" placeholder="Anything else you’d like us to know?"></textarea><span class="field-help">Only the review team sees these notes.</span></label>
      </fieldset>

      <fieldset class="submission-intent" id="sub-step-launch">
        <legend><span class="submission-step-label">04 · Launch options</span>Choose how to launch</legend>
        <label>Launch option
          <select name="submissionType" id="submission-type" aria-describedby="free-launch-help">
            <option value="directory">Free launch (add a badge to your site)</option>
            <option value="instant" id="submission-instant-option" hidden disabled>Instant Publishing</option>
            <option value="founding-feature">Membership Spotlight</option>
          </select>
        </label>
        <p id="free-launch-help" class="field-help">After saving you’ll get a badge to add to your website. Verify it from your dashboard and your project launches automatically on its scheduled date. <span id="free-launch-date"></span></p>
        <p id="instant-launch-help" class="field-help" hidden>Pay once with your account email, then return to verify payment and publish. Your project goes live right away and takes an open homepage spot for 7 days.</p>
        <div id="membership-fields" class="submission-option-detail" hidden><p>Sign in on the <a href="/membership#member-sign-in">membership page</a> first to request your included spotlight. We review each request.</p></div>
      </fieldset>

      <div class="submission-review">
        <h2>Confirm and submit</h2>
        <p>Track your project’s status in <a href="/account">Your Projects</a>.</p>
        <label class="honeypot" aria-hidden="true">Leave this empty<input name="company" tabindex="-1" autocomplete="off"/></label>
        <label class="consent"><input name="consent" type="checkbox" required checked/><span>I confirm that I own or am authorized to submit this project and allow Digivated to display the submitted information and project logo.</span></label>
        <label class="consent"><input name="emailOutreachConsent" type="checkbox" checked/><span>Send me one follow-up email about my submission, my account, and how to opt in to weekly updates. I will not be subscribed automatically.</span></label>
        <label class="consent"><input name="activityNotifications" type="checkbox" aria-describedby="submission-notification-help" checked/><span><strong>Turn on all activity notifications</strong></span></label>
        <p id="submission-notification-help" class="field-help">Get replies, follows, messages, and project feedback on Digivated. Approval alerts are automatic. Manage your choices in <a href="/notifications">Notifications</a>.</p>
        <button class="button primary" type="submit" disabled>Sign in to submit your project</button>
        <noscript>Enable JavaScript to submit your project securely.</noscript>
        <p class="form-status" id="submission-status" role="status" aria-live="polite" tabindex="-1"></p>
        <section id="submission-badge" class="submission-option-detail" aria-labelledby="submission-badge-title" hidden>
          <p class="eyebrow">STEP 1 OF 4 DONE</p>
          <h3 id="submission-badge-title" tabindex="-1">Project saved. Next: add your badge.</h3>
          <div id="submission-badge-tracker"></div>
          <ol class="badge-next-steps fl-howto"><li><strong>Pick a badge style below and copy its code.</strong> Every style shows your live upvotes and links to your listing.</li><li><strong>Paste it into your website’s HTML</strong> (for example the footer) and publish the change.</li><li><strong>Press “Check my website” below.</strong> Once we find the badge, your launch is locked in. You can also do this later from your dashboard.</li></ol><p id="submission-badge-launch" class="field-help"></p><p class="field-help"><strong>Verification is required.</strong> Once verified, the daily cycle publishes your project when its launch date arrives. No admin approval needed.</p>
          <div id="submission-badge-picker"></div>
          <div class="submission-account-actions fl-actions">
            <button class="button primary fl-btn-primary" id="submission-badge-verify" type="button" hidden>Check my website</button>
            <a class="button" id="submission-badge-dashboard" href="/account#account-submissions">Go to my dashboard →</a>
          </div>
          <p class="fl-status" id="submission-badge-status" role="status" aria-live="polite"></p>
        </section>
      </div>
      </div>
    </form>

    <aside class="submission-preview-panel" aria-labelledby="listing-preview-title">
      <div class="submission-preview-sticky"><p class="submission-step-label">YOUR PUBLIC LISTING</p><h2 id="listing-preview-title">Preview your project</h2>
      <article class="submission-listing-preview"><div class="listing-preview-cover"><img data-listing-image alt="" hidden/><span data-listing-placeholder>Your project logo</span></div><div class="listing-preview-copy"><span data-listing-category>Category</span><h3 data-listing-name>Your project name</h3><p data-listing-description>A clear description of what your project does and who it helps.</p><span data-listing-domain>your-project.com</span></div><div class="listing-preview-footer"><span>Feedback <b>0</b></span><span>↑ Upvote <b>0</b></span></div></article>
      <p class="field-help">Your email, order details, and review notes stay private.</p></div>
    </aside>
  </div>
  <script>import '../scripts/submission.js'; import '../scripts/submission-preview.js';</script>
</Platform>
