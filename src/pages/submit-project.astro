---
import Platform from '../layouts/Platform.astro';
import { projectPricingOptions } from '../lib/project-pricing.mjs';
import { projectCategories } from '../data/community.mjs';
import '../styles/submission-flow.css';
---
<Platform title="Submit Your Project" description="Share what you built. Digivated reviews projects before they appear in the directory.">
  <header class="page-intro submission-intro">
    <p class="eyebrow">Share your work</p>
    <h1>Submit a project.</h1>
    <p class="lede">Add your project details, preview your listing, and choose how to launch.</p>
  </header>

  <div class="submission-layout submission-workspace">
    <form class="submission-form" id="project-form" action="/api/submissions" method="post">
      <div id="submission-account-callout" class="submission-account-callout">
        <strong>Create a free account to submit</strong>
        <p>Sign in to submit, track your review, and see private feedback.</p>
        <div class="submission-account-actions"><a class="button primary" href="/login?mode=signup&amp;next=%2Fsubmit-project">Create an account</a><a href="/login?next=%2Fsubmit-project">Already have one? Sign in</a></div>
      </div>
      <p id="submission-account-status" class="submission-account-status" role="status" aria-live="polite" hidden></p>

      <div id="instant-launch-resume" class="submission-review" hidden><h2>Finish publishing</h2><p>Use the same email at checkout as on your Digivated account. After paying, return here and verify your purchase.</p><div class="submission-account-actions"><a id="instant-launch-checkout" class="button primary" target="_blank" rel="noopener">Open checkout ↗</a><button id="instant-launch-verify" class="button" type="button">Verify payment and publish</button></div><p id="instant-launch-status" role="status" aria-live="polite"></p><a id="instant-launch-listing" hidden>View your live project →</a></div>
      <div id="submission-details" hidden>


      <fieldset>
        <legend><span class="submission-step-label">01 · Project details</span>Tell us about your project</legend>
        <p class="field-help">Start with your website. You can import its name and description, then review and edit them.</p><label>Project name<input name="name" placeholder="Your product name" maxlength="120" required/></label>
        <label>Project URL<input name="url" type="url" placeholder="https://your-project.com" maxlength="500" required/></label>
        <button type="button" id="project-import">[ Import website details ]</button><p id="project-import-status" role="status"></p>
        <label>Project description<textarea name="description" rows="4" minlength="20" maxlength="600" required placeholder="What does it do, and who is it for?"></textarea><span class="field-help">20–600 characters. Start with what it does, then who it helps. Avoid hashtags and promotional slogans.</span></label>
        <label>Category<select aria-describedby="project-category-help" name="category" required><option value="">Choose a category</option>{projectCategories.map(c=><option>{c}</option>)}</select></label><p id="project-category-help" class="field-help">Choose the main thing your project helps people do. Use Education for learning tools and Developer Tools for coding utilities.</p>
        <label>Pricing <span class="quiet">(optional)</span><select name="pricing"><option value="">Not specified</option>{projectPricingOptions.map(option => <option>{option}</option>)}</select></label>
      </fieldset>

      <fieldset>
        <legend>Project logo</legend>
        <label class="submission-upload">Project logo<input name="image" id="project-image" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="project-image-help" required/><span class="field-help" id="project-image-help">Required. Upload your project’s logo, not a website screenshot. JPG, PNG, or WebP, up to 10 MB. A square PNG or WebP with a transparent background works best. We preserve the full logo in a consistent square frame.</span></label>
        <div id="project-image-preview" class="submission-image-preview" hidden><img alt="Selected project logo preview"/><span id="project-image-name"></span></div>
      </fieldset>

      <fieldset>
        <legend><span class="submission-step-label">02 · Creator details</span>About you</legend>
        <p class="submission-section-help">We’ll use these details to review your submission. Your email stays private.</p>
        <div class="form-row"><label>Creator name<input name="creator" placeholder="Your name" autocomplete="name" maxlength="100" required/></label><label>Email<input name="email" placeholder="you@example.com" type="email" autocomplete="email" maxlength="254" required/><span class="field-help">Use the email linked to your account.</span></label></div>
        <label>Social handle <span class="quiet">(optional)</span><input name="social" maxlength="200" placeholder="@yourhandle — include the platform"/></label>
        <label>Notes for the review <span class="quiet">(optional)</span><textarea name="notes" rows="3" maxlength="2000" placeholder="Anything else you’d like us to know?"></textarea><span class="field-help">Only the review team sees these notes.</span></label>
      </fieldset>

      <fieldset class="submission-intent">
        <legend><span class="submission-step-label">03 · Launch options</span>Choose how to launch</legend>
        <label>Launch option
          <select name="submissionType" id="submission-type">
            <option value="directory">Free</option>
            <option value="instant" id="submission-instant-option" hidden disabled>Instant Publishing ($5)</option>
            <option value="founding-feature">Membership Spotlight</option>
          </select>
        </label>
        <p id="free-launch-help" class="field-help">Free: add a Digivated text badge to your website, verify it in Your Projects, and join the scheduled launch queue. Your listing stays available after launch. <span id="free-launch-date"></span> An admin can also approve it manually.</p>
        <p id="instant-launch-help" class="field-help" hidden>Save your project, complete the one-time payment using your Digivated account email, then return to publish after we verify the payment.</p>
        <div id="membership-fields" class="submission-option-detail" hidden><p>Sign in on the <a href="/membership#member-sign-in">membership page</a> first. This uses your one included project spotlight, with no extra payment. Review is required; a feature is never guaranteed.</p></div>
      </fieldset>

      <div class="submission-review">
        <h2>Confirm and submit</h2>
        <p>Track your project’s status in <a href="/account">Your Projects</a>. New free submissions need badge verification before their scheduled launch. Membership Spotlight stays subject to review.</p>
        <label class="honeypot" aria-hidden="true">Leave this empty<input name="company" tabindex="-1" autocomplete="off"/></label>
        <label class="consent"><input name="consent" type="checkbox" required/><span>I confirm that I own or am authorized to submit this project and allow Digivated to display the submitted information and project logo.</span></label>
        <label class="consent"><input name="emailOutreachConsent" type="checkbox"/><span>Send me one follow-up email about my submission, my account, and how to opt in to weekly updates. I will not be subscribed automatically.</span></label>
        <button class="button primary" type="submit" disabled>Sign in to submit your project</button>
        <noscript>Enable JavaScript to submit your project securely.</noscript>
        <p class="form-status" id="submission-status" role="status" aria-live="polite" tabindex="-1"></p>
      </div>
      </div>
    </form>

    <aside class="submission-preview-panel" aria-labelledby="listing-preview-title">
      <div class="submission-preview-sticky"><p class="submission-step-label">YOUR PUBLIC LISTING</p><h2 id="listing-preview-title">Preview your project</h2><p class="field-help">See how your details will look before submitting.</p>
      <article class="submission-listing-preview"><div class="listing-preview-cover"><img data-listing-image alt="" hidden/><span data-listing-placeholder>Your project logo</span></div><div class="listing-preview-copy"><span data-listing-category>Category</span><h3 data-listing-name>Your project name</h3><p data-listing-description>A clear description of what your project does and who it helps.</p><span data-listing-domain>your-project.com</span></div><div class="listing-preview-footer"><span>Feedback <b>0</b></span><span>↑ Upvote <b>0</b></span></div></article>
      <div class="submission-quality"><h3>A listing that stands out</h3><ul><li>Use the real product name.</li><li>Upload a clear project logo.</li><li>Explain one useful outcome.</li><li>Link directly to your project.</li></ul></div><p class="field-help">Your email, order details, and review notes stay private.</p></div>
    </aside>
  </div>
  <script>import '../scripts/submission.js'; import '../scripts/submission-preview.js';</script>
</Platform>
