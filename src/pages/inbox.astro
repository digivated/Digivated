---
import Platform from '../layouts/Platform.astro';
import '../styles/project-account.css';
---
<Platform title="Inbox" description="Private conversations with creators on Digivated.">
 <section class="creator-inbox-page" aria-labelledby="inbox-title">
  <header class="creator-inbox-heading"><a href="/creators">← Creators</a><p class="eyebrow">CREATOR CONVERSATIONS</p><h1 id="inbox-title">Inbox</h1><p>Talk directly with the people behind the projects.</p></header>
  <div class="creator-inbox-layout"><aside class="creator-inbox-list" aria-label="Conversations"><div class="creator-inbox-list-head"><h2>Messages</h2><button id="inbox-new" type="button">New message</button></div><div id="inbox-picker" class="inbox-picker" hidden><label for="inbox-search">Find a creator</label><input id="inbox-search" type="search" placeholder="Search creators" autocomplete="off"/><div id="inbox-people"></div></div><p id="inbox-list-status" role="status">Loading conversations…</p><div id="inbox-conversations"></div></aside><div class="creator-inbox-thread"><header id="inbox-contact"><span>Choose a conversation</span></header><div id="inbox-messages" aria-live="polite"><div class="inbox-welcome">Your conversations live here. Visit a creator profile to start one.</div></div><form id="inbox-form" hidden><label for="inbox-body">Message</label><textarea id="inbox-body" maxlength="1000" rows="2" placeholder="Write a thoughtful message…" required></textarea><div><span>Keep it useful. Links are not allowed in messages.</span><button class="button primary" type="submit">Send</button></div></form><p id="inbox-action-status" role="status" aria-live="polite"></p></div></div>
 </section>
 <script>import '../scripts/creator-inbox.js';</script>
</Platform>
