---
import Platform from '../layouts/Platform.astro';
import '../styles/project-account.css';
---
<Platform title="Creators" description="A place for independent builders to share progress, ask questions, and meet other creators.">
  <section class="creator-social" aria-labelledby="creators-title">
    <header class="creator-social-heading"><p class="eyebrow">THE BUILDER CONVERSATION</p><h1 id="creators-title">Creators</h1><p>Share what you’re making, ask for feedback, and meet the people behind the projects.</p></header>
    <div class="creator-social-layout">
      <aside class="creator-social-rail" aria-label="Creator navigation"><p class="eyebrow">YOUR NETWORK</p><a class="active" href="/creators" aria-current="page">Conversation</a><a href="/discover">Explore projects</a><a href="/account">Your account</a><div class="creator-social-rail-note">A place to build in public and hear from other makers.</div></aside>
      <main class="creator-social-main">
        <nav class="creator-tabs" aria-label="Creator feed"><button class="active" type="button" data-creator-filter="latest">Latest</button><button type="button" data-creator-filter="following">Following</button><button type="button" data-creator-filter="saved">Saved</button><button type="button" data-creator-filter="people">People</button></nav>
        <section id="creator-composer" class="creator-composer" hidden aria-label="Write a post"><label for="creator-post-body">What are you building?</label><textarea id="creator-post-body" maxlength="280" rows="3" placeholder="Share progress, ask a question, or start a conversation…"></textarea><div class="creator-composer-bottom"><span>Keep links on your project profile · <span id="creator-post-count">0</span>/280</span><button id="creator-post-submit" class="button primary" type="button">Post</button></div></section>
        <p id="creators-status" role="status" aria-live="polite">Loading the conversation…</p>
        <div id="creators-feed" class="creator-timeline"></div><div id="creators-empty" class="creator-empty" hidden><div class="creator-empty-orbit" aria-hidden="true"><span></span><span></span><span></span></div><p class="eyebrow">START THE CONVERSATION</p><h2>Every project starts somewhere.</h2><p>Tell builders what you’re making, ask a specific question, or share a small win. The first post is yours.</p><div class="creator-empty-actions"><button type="button" data-prompt="What are you building today?">What are you building?</button><button type="button" data-prompt="What feedback would help you most right now?">Ask for feedback</button><a href="/discover">Explore projects ↗</a></div><div id="creator-project-picks" class="creator-project-picks"></div></div>
        <button id="creators-more" class="button" type="button" hidden>Load more</button>
        <div id="creators-people" hidden><label class="creator-search-label">Find a creator<input id="creator-search" type="search" placeholder="Search builders by name or bio" autocomplete="off"/></label><div id="creators-grid" class="creator-directory-list"></div></div>
      </main>
      <aside class="creator-social-sidebar"><h2>Your space</h2><p>Keep your posts and published projects together on your creator profile.</p><a id="creator-my-profile" class="button" href="/account">My profile</a><a href="/account">Edit profile and logo →</a><div class="creator-social-guidelines"><strong>Good conversation starts here</strong><p>Share useful updates and specific feedback. Project links live on profiles, so the feed stays easy to read.</p></div></aside>
    </div>
  </section>
  <script>import '../scripts/creators.js';</script>
</Platform>
