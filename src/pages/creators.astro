---
import Platform from '../layouts/Platform.astro';
import '../styles/project-account.css';
---
<Platform title="Creators" description="A place for independent builders to share progress, ask questions, and meet other creators.">
  <section class="creator-social" aria-labelledby="creators-title">
    <div class="creator-feed-shell">
      <header class="creator-social-heading">
        <div><p class="eyebrow">DIGIVATED COMMUNITY</p><h1 id="creators-title">The builder feed.</h1><p>Progress, questions, and ideas from the people making things.</p></div>
        <nav class="creator-quicknav" aria-label="Your creator space"><a href="/discover">Projects</a><a href="/inbox">Inbox<span id="creator-inbox-count"></span></a><a id="creator-my-profile" href="/account">My profile</a></nav>
      </header>
      <main class="creator-social-main">
        <div id="creator-people-strip" class="creator-people-strip" hidden></div>
        <nav class="creator-tabs" aria-label="Creator feed"><button class="active" type="button" data-creator-filter="latest">Latest</button><button type="button" data-creator-filter="following">Following</button><button type="button" data-creator-filter="saved">Saved</button><button type="button" data-creator-filter="people">People</button></nav>
        <section id="creator-composer" class="creator-composer" hidden aria-label="Write a post"><label for="creator-post-body">Share something with builders</label><textarea id="creator-post-body" maxlength="280" rows="3" placeholder="What are you building? Share a small win, ask a question, or show your work…"></textarea><div id="creator-media-preview" class="creator-media-preview" hidden></div><div class="creator-composer-tools"><label class="creator-media-upload" for="creator-media-input">＋ Add photo or video</label><input id="creator-media-input" type="file" accept="image/jpeg,image/png,image/webp,video/mp4,video/webm" hidden/><span>Images up to 3 MB · videos up to 12 MB</span></div><div class="creator-composer-bottom"><span>Links live on your profile · <span id="creator-post-count">0</span>/280</span><button id="creator-post-submit" class="button primary" type="button">Post</button></div></section>
        <p id="creators-status" role="status" aria-live="polite">Loading the feed…</p>
        <div id="creators-feed" class="creator-timeline"></div>
        <div id="creators-empty" class="creator-empty" hidden><div class="creator-empty-mark" aria-hidden="true"><img src="/digivated-favicon.png" alt="" width="54" height="54"/></div><div><p class="eyebrow">THE FIRST WORD</p><h2>Start a conversation.</h2><p>Share a build update or ask the question you wish someone had answered for you.</p></div><div class="creator-empty-actions"><button type="button" data-prompt="What are you building today?">Share your build</button><button type="button" data-prompt="What feedback would help you most right now?">Ask for feedback</button></div></div><div id="creator-project-picks" class="creator-project-picks" hidden></div>
        <button id="creators-more" class="button" type="button" hidden>Load more</button>
        <div id="creators-people" hidden><label class="creator-search-label">Find a creator<input id="creator-search" type="search" placeholder="Search builders by name or bio" autocomplete="off"/></label><div id="creators-grid" class="creator-directory-list"></div></div>
      </main>
    </div>
  </section>
  <script>import '../scripts/creators.js';</script>
</Platform>
