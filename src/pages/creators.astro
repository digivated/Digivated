---
import Platform from '../layouts/Platform.astro';
import '../styles/project-account.css';
---
<Platform title="Creators" description="Meet independent builders sharing their work on Digivated."><section class="creator-public"><header class="creator-directory-intro"><p class="eyebrow">THE PEOPLE BUILDING</p><h1>Meet the creators.</h1><p>Find builders, explore their projects, and follow their work.</p></header><nav class="creator-tabs" aria-label="Creator directory"><button class="active" type="button" data-creator-filter="all">Discover</button><button type="button" data-creator-filter="following">Following</button></nav><label class="creator-search-label">Find a creator<input id="creator-search" type="search" placeholder="Search builders by name or bio" autocomplete="off"/></label><p id="creators-status" role="status">Loading creators…</p><div id="creators-grid" class="creator-directory-list"></div></section><script>import '../scripts/creators.js';</script></Platform>
