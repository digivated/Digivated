---
import Platform from '../layouts/Platform.astro';
import UiIcon from '../components/UiIcon.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import SiteActivity from '../components/SiteActivity.astro';
import ProjectTicker from '../components/ProjectTicker.astro';
import '../styles/project-wall.css';
---
<Platform title="Discover projects worth seeing" description="Explore independent projects on Digivated. Meet builders, share your work, and leave feedback.">
  <SiteActivity/>
  <section class="home-editorial" aria-labelledby="home-title">
    <p class="home-editorial-kicker">A HOME FOR WHAT YOU'RE BUILDING</p>
    <canvas class="home-signal" aria-hidden="true"></canvas>
    <h1 id="home-title">Good projects deserve<br/><em>to be discovered.</em></h1>
    <p>Explore work from independent builders, give useful feedback, and share what you're making.</p>
    <div class="home-editorial-actions"><a class="button primary" href="/discover#project-wall">Explore projects <UiIcon name="arrow" size={16}/></a><a class="button" href="/submit-project">Share your project <UiIcon name="arrow" size={16}/></a></div>

    <a class="home-editorial-scroll" href="#featured-projects">FEATURED PROJECTS <span aria-hidden="true">↓</span></a>
  </section>
  <FeaturedProjects/>
  <ProjectTicker/>
</Platform>
<script>import '../scripts/hero-signal.js';</script>
