---
import Platform from '../layouts/Platform.astro';
import DiscoveryHero from '../components/DiscoveryHero.astro';
import LaunchBoard from '../components/LaunchBoard.astro';
import FeedbackPoints from '../components/FeedbackPoints.astro';
import ActivityMark from '../components/ActivityMark.astro';
import '../styles/project-wall.css';
import '../styles/home-hero.css';
---
<Platform title="Indie Products and Weekly Launches" description="Find useful products from independent makers. Browse weekly launches, share feedback and launch your own product for free.">
  <DiscoveryHero/>
  <div class="dg-hero-panel">
    <dl class="dg-hero-stats">
      <div class="dg-hero-stat is-countdown"><dt>Next free launch</dt><dd><span data-countdown-fallback>Mondays, 9 AM ET</span><time id="queue-countdown" role="timer" aria-live="off" hidden></time><span class="dg-week-bar" data-week-bar aria-hidden="true"></span></dd></div>
      <div class="dg-hero-stat"><dt>Products</dt><dd data-stat-products>—</dd></div>
      <div class="dg-hero-stat"><dt>Browsing now</dt><dd class="dg-hero-activity"><span data-site-online>—</span><ActivityMark kind="orbit"/></dd></div>
      <div class="dg-hero-stat"><dt>Site visits</dt><dd class="dg-hero-activity"><span data-site-visits>—</span><ActivityMark kind="ribbon"/></dd></div>
    </dl>
  </div>
  <div class="dg-home" data-spots>
    <LaunchBoard/>
    <div class="dg-home-extras">
      <section class="dg-home-spots" data-section-reveal aria-labelledby="dg-home-spots-title">
        <h2 id="dg-home-spots-title">Featured products</h2>
        <p class="dg-spots-status" data-featured-status role="status" hidden></p>
        <div class="dg-spot-grid" data-spot-grid></div>
      </section>
      <section class="dg-home-side" data-section-reveal aria-labelledby="dg-home-community-title">
        <h2 id="dg-home-community-title">For makers</h2>
        <FeedbackPoints variant="strip" cta="/discover?sort=needs" ctaLabel="Find a product that needs feedback"/>
        <section class="dg-rail-threads" data-rail-threads aria-labelledby="dg-rail-threads-title" hidden>
          <h3 id="dg-rail-threads-title"><a href="/threads">Trending threads</a></h3>
          <ol data-rail-thread-list></ol>
          <a class="dg-quiet-link" href="/threads">All threads →</a>
        </section>
      </section>
    </div>
  </div>
  <section class="dg-about" data-section-reveal aria-labelledby="dg-about-title">
    <h2 id="dg-about-title">How Digivated works</h2>
    <div>
      <p>Free launches go live on Mondays. <a href="/about">Learn how to launch</a>.</p>
      <p id="how-points-work" class="dg-about-points">Earn bonus upvotes by <a href="/points">leaving useful feedback</a>.</p>
    </div>
  </section>
</Platform>

<script>
  import { freeLaunchDay, nextFreeLaunch } from '../lib/launch-calendar.mjs';

  const countdown = document.querySelector<HTMLTimeElement>('#queue-countdown');
  const weekBar = document.querySelector<HTMLElement>('[data-week-bar]');
  const fallback = document.querySelector<HTMLElement>('[data-countdown-fallback]');
  let timer: ReturnType<typeof setTimeout>;
  let target = 0;

  function updateCountdown() {
    clearTimeout(timer);
    if (!countdown || document.hidden) return;
    const now = Date.now();
    if (now >= target) {
      countdown.dateTime = nextFreeLaunch(now);
      countdown.setAttribute('aria-label', `Next free launch on ${freeLaunchDay(countdown.dateTime)} at 9:00 AM Eastern`);
      target = Date.parse(countdown.dateTime);
      if (fallback) fallback.hidden = true;
      countdown.hidden = false;
    }
    const remaining = target - now;
    const minutes = Math.ceil(remaining / 60_000);
    const days = Math.floor(minutes / 1440);
    const hours = Math.floor(minutes / 60) % 24;
    countdown.textContent = `${days}d ${String(hours).padStart(2, '0')}h ${String(minutes % 60).padStart(2, '0')}m`;
    if (weekBar) {
      const percent = (1 - remaining / (7 * 86_400_000)) * 100;
      weekBar.style.setProperty('--launch-progress', String(Math.max(0, Math.min(100, percent))) + '%');
    }
    timer = setTimeout(updateCountdown, remaining % 60_000 || 60_000);
  }

  updateCountdown();
  document.addEventListener('visibilitychange', updateCountdown);
</script>
