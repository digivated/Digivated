---
import Platform from '../layouts/Platform.astro';
import UiIcon from '../components/UiIcon.astro';
import HomeLaunches from '../components/HomeLaunches.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import SiteActivity from '../components/SiteActivity.astro';
import ProjectTicker from '../components/ProjectTicker.astro';
import '../styles/project-wall.css';
import '../styles/home-refinement.css';
import '../styles/home-about.css';
---
<Platform title="Indie Project Directory & Weekly Launches" description="Discover indie software and tools, upvote weekly launches, and give builders feedback. Submit your own project to Digivated for free.">
  <section class="home-editorial" aria-labelledby="home-title">
    <div class="home-workshop-copy">
    <p class="home-editorial-kicker">A HOME FOR WHAT YOU'RE BUILDING</p>
    <h1 id="home-title">Get your product<br/><em>in front of <span data-site-visits-headline>visitors.</span></em></h1>
    <p>Find indie projects, give feedback, and share what you’re building.</p>
    <div class="home-editorial-actions">
      <a class="button primary share-project-cta" href="/submit-project">Share your project <UiIcon name="arrow" size={18}/></a>
      <a class="button" href="#this-week">Explore this week <UiIcon name="arrow" size={16}/></a>
    </div>
    </div>
    <div class="fl-window" aria-hidden="true">
      <div class="fl-window-bar"><span class="fl-window-dots">● ● ●</span><span class="fl-hud">digivated / workbench</span><span class="fl-hud fl-live">● live</span></div>
      <pre class="ascii-field home-workshop" data-ascii-field></pre>
    </div>
  </section>
  <section class="fl-home-stats" aria-label="Digivated right now">
    <div class="fl-stat"><SiteActivity/></div>
      <div class="fl-stat"><aside class="queue-countdown" aria-label="Weekly project queue">
        <div>
          <strong>Next free project launch</strong>
          <small>Weekly · Mondays at 9:00 AM Eastern</small>
        </div>
        <time id="queue-countdown" role="timer" aria-live="off"></time>
      </aside></div>
      <div class="fl-stat"><details class="home-updates">
        <summary>What’s new <UiIcon name="chevron" size={14}/></summary>
        <ul>
          <li><a href="/submit-project">Free launches</a> now publish on schedule after you verify your website badge.</li>
          <li><a href="/creators">Creators</a> can share updates and media, follow builders, and send messages.</li>
          <li><a href="/invstr">Market Scanner</a> works without API keys; optional connections add more data.</li>
        </ul>
      </details></div>
  </section>
  <div id="home-spotlights"><FeaturedProjects/></div>
  <HomeLaunches/>
  <ProjectTicker/>
  <section class="home-about" aria-labelledby="home-about-title">
    <p class="home-about-label">ABOUT DIGIVATED</p>
    <h2 id="home-about-title">Discover and launch indie projects</h2>
    <p>Digivated is an indie project directory and launch community. Browse <a href="/discover">independent software and tools</a>, see <a href="/rankings">community upvote rankings</a>, or <a href="/submit-project">submit your project</a> for a free launch.</p>

    <div class="home-about-details">
      <div><h3>How are projects listed?</h3><p>Verify a badge to schedule a free launch, pay $3 to publish right away, or request a Membership Spotlight. Every launch gets a permanent page.</p></div>
      <div><h3>How are projects featured?</h3><p>We review projects for Spotlight and sort featured picks by views. A spotlight doesn’t guarantee traffic or engagement.</p></div>
    </div>
    <a href="/about">Read how Digivated works <UiIcon name="arrow" size={15}/></a>
  </section>
</Platform>

<script>
  const countdown = document.querySelector<HTMLTimeElement>('#queue-countdown');

  function updateCountdown() {
    if (!countdown) return;
    const now = new Date();
    // Free launches become eligible on Monday; the scheduled queue job
    // publishes them on Mondays at 14:00 UTC (9:00 AM Eastern).
    const daysUntilMonday = (8 - now.getUTCDay()) % 7;
    let target = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + daysUntilMonday, 14, 0);
    if (target <= now.getTime()) target += 7 * 86_400_000;

    const minutes = Math.ceil((target - now.getTime()) / 60_000);
    const days = Math.floor(minutes / 1440);
    const hours = Math.floor(minutes / 60) % 24;
    countdown.dateTime = new Date(target).toISOString();
    countdown.textContent = `${days}d ${String(hours).padStart(2, '0')}h ${String(minutes % 60).padStart(2, '0')}m`;
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>

<style>
  @layer ascii {
  :global(html#digivated-root[data-ascii] body.home-refresh #main .home-editorial-actions .share-project-cta) {
    display: inline-flex;
    align-items: center;
    gap: .75rem;
    min-height: 48px;
    padding: .8rem 1.1rem !important;
    background: transparent !important;
    color: #eee !important;
    border: 1px solid #aaa !important;
    font-size: 1rem !important;
    font-weight: 700;
    text-decoration: none !important;
  }

  :global(html#digivated-root[data-ascii] body.home-refresh #main .home-editorial-actions .share-project-cta:hover) {
    background: rgb(255 255 255 / 8%) !important;
    border-color: #eee !important;
    text-decoration: underline !important;
  }

  }

  .queue-countdown {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .6rem 1.5rem;
    inline-size: fit-content;
    max-inline-size: 100%;
    margin-block: 1rem 0;
    padding-block: .65rem;
  }

  .queue-countdown strong,
  .queue-countdown small {
    display: block;
  }

  .queue-countdown strong {
    font-size: .875rem;
  }

  .queue-countdown small {
    margin-block-start: .3rem;
    font-size: .72rem;
  }

  .queue-countdown time {
    font-size: clamp(1.35rem, 2.8vw, 2rem);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .home-updates {
    width: min(100%, 640px);
    margin: 22px 0 0;
    border-block: 1px solid #ffffff29;
    color: #d5d5d5;
  }

  .home-updates summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 48px;
    cursor: pointer;
    list-style: none;
    font-size: 13px;
    font-weight: 650;
  }

  .home-updates summary::-webkit-details-marker { display: none; }
  .home-updates summary svg { flex: none; transition: transform .2s ease; }
  .home-updates[open] summary svg { transform: rotate(180deg); }
  .home-updates summary:focus-visible, .home-updates a:focus-visible { outline: 2px solid #d2b5ff; outline-offset: 3px; }
  .home-updates ul { display: grid; gap: 14px; margin: 0; padding: 2px 0 20px 20px; font-size: 12px; line-height: 1.6; }
  .home-updates li::marker { color: #a98ac7; }
  .home-updates a { color: #f3e5ff; text-underline-offset: .25em; }
  @media(prefers-reduced-motion:reduce) { .home-updates summary svg { transition: none; } }
</style>
