---
import Platform from '../layouts/Platform.astro';
import UiIcon from '../components/UiIcon.astro';
import HomeLaunches from '../components/HomeLaunches.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import SiteActivity from '../components/SiteActivity.astro';
import ProjectTicker from '../components/ProjectTicker.astro';
import '../styles/project-wall.css';
import '../styles/home-refinement.css';
import '../styles/home-about.css';
---
<Platform title="Good projects deserve to be discovered" description="Discover independent projects on Digivated. Meet builders, give feedback, and submit your own work for review.">
  <SiteActivity/>
  <aside class="queue-countdown" aria-label="Weekly project queue">
    <div>
      <strong>Next free project launch</strong>
      <small>Weekly · Monday at 00:10 UTC</small>
    </div>
    <time id="queue-countdown" role="timer" aria-live="off"></time>
  </aside>
  <section class="home-editorial" aria-labelledby="home-title">
    <div class="home-workshop-copy">
    <details class="home-whats-new">
      <summary><span>What’s New?</span><UiIcon name="chevron" size={14}/></summary>
      <ul>
        <li>Catch up on <a href="/news">News</a> and find useful <a href="/resources">Resources</a>.</li>
        <li>See what’s trending in <a href="/rankings">Rankings</a> and meet builders in the <a href="/creators">Creator Hub</a>.</li>
        <li>Explore the new project pages and leave feedback as a guest.</li>
        <li>The <a href="/membership">$5 Membership</a> includes access to the full site.</li>
      </ul>
    </details>
    <p class="home-editorial-kicker">A HOME FOR WHAT YOU'RE BUILDING</p>
    <h1 id="home-title">Get your product<br/><em>in front of <span data-site-visits-headline>visitors.</span></em></h1>
    <p>Find indie projects, give feedback, and share what you’re building.</p>
    <div class="home-editorial-actions"><a class="button primary" href="#this-week">Explore this week <UiIcon name="arrow" size={16}/></a><a class="button" href="/submit-project">Share your project <UiIcon name="arrow" size={16}/></a></div>
    </div>
    <pre class="ascii-field home-workshop" data-ascii-field aria-hidden="true"></pre>
  </section>
  <div id="home-spotlights"><FeaturedProjects/></div>
  <HomeLaunches/>
  <ProjectTicker/>
  <section class="home-about" aria-labelledby="home-about-title">
    <p class="home-about-label">ABOUT DIGIVATED</p>
    <h2 id="home-about-title">A place to find good work.</h2>

    <div class="home-about-details">
      <div><h3>How are projects listed?</h3><p>Verify a badge to schedule a free launch, pay $5 to publish right away, or request a Membership Spotlight. Every launch gets a permanent page.</p></div>
      <div><h3>How are projects featured?</h3><p>We review projects for Spotlight and sort featured picks by views. A spotlight doesn’t guarantee traffic or engagement.</p></div>
    </div>
    <a href="/about">Read how Digivated works <UiIcon name="arrow" size={15}/></a>
  </section>
</Platform>

<script>
  const countdown = document.querySelector<HTMLTimeElement>('#queue-countdown');

  function updateCountdown() {
    if (!countdown) return;
    const now = new Date();
    // Free launches become eligible on Monday at midnight UTC.
    // The scheduled queue job runs daily at 00:10 UTC.
    const daysUntilMonday = (8 - now.getUTCDay()) % 7;
    let target = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + daysUntilMonday, 0, 10);
    if (target <= now.getTime()) target += 7 * 86_400_000;

    const minutes = Math.ceil((target - now.getTime()) / 60_000);
    const days = Math.floor(minutes / 1440);
    const hours = Math.floor(minutes / 60) % 24;
    countdown.dateTime = new Date(target).toISOString();
    countdown.textContent = `${days}d ${String(hours).padStart(2, '0')}h ${String(minutes % 60).padStart(2, '0')}m`;
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>

<style>
  .queue-countdown {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .6rem 1.5rem;
    inline-size: fit-content;
    max-inline-size: 100%;
    margin-block: 1rem 0;
    padding-block: .65rem;
  }

  .queue-countdown strong,
  .queue-countdown small {
    display: block;
  }

  .queue-countdown strong {
    font-size: .875rem;
  }

  .queue-countdown small {
    margin-block-start: .3rem;
    font-size: .72rem;
  }

  .queue-countdown time {
    font-size: clamp(1.35rem, 2.8vw, 2rem);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
