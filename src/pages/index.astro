---
import Platform from '../layouts/Platform.astro';
import UiIcon from '../components/UiIcon.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import SiteActivity from '../components/SiteActivity.astro';
import ProjectTicker from '../components/ProjectTicker.astro';
import '../styles/project-wall.css';
---
<Platform title="Discover projects worth seeing" description="Explore independent projects on Digivated. Meet builders, share your work, and leave feedback.">
  <SiteActivity/>
  <section class="home-editorial" aria-labelledby="home-title">
    <div class="home-signal" aria-hidden="true"><svg viewBox="0 0 1600 480" preserveAspectRatio="none" focusable="false"><defs><linearGradient id="home-signal-color" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#a66ef1" stop-opacity="0"/><stop offset=".2" stop-color="#b887ff" stop-opacity=".42"/><stop offset=".5" stop-color="#d9bfff" stop-opacity=".78"/><stop offset=".8" stop-color="#b887ff" stop-opacity=".42"/><stop offset="1" stop-color="#a66ef1" stop-opacity="0"/></linearGradient></defs><path pathLength="1" d="M0 260 C100 260 145 235 240 244 S390 300 490 257 S625 159 740 213 S860 302 975 263 S1090 172 1210 228 S1405 284 1600 218" fill="none" stroke="url(#home-signal-color)" stroke-width="2" vector-effect="non-scaling-stroke"><animate attributeName="d" dur="24s" repeatCount="indefinite" values="M0 260 C100 260 145 235 240 244 S390 300 490 257 S625 159 740 213 S860 302 975 263 S1090 172 1210 228 S1405 284 1600 218;M0 225 C115 235 165 280 285 258 S425 175 535 222 S655 300 790 250 S925 165 1040 215 S1200 295 1320 250 S1470 195 1600 235;M0 260 C100 260 145 235 240 244 S390 300 490 257 S625 159 740 213 S860 302 975 263 S1090 172 1210 228 S1405 284 1600 218" keyTimes="0;.5;1" calcMode="spline" keySplines=".42 0 .58 1;.42 0 .58 1"/></path></svg></div>
    <p class="home-editorial-kicker">A HOME FOR WHAT YOU'RE BUILDING</p>
    <h1 id="home-title">Good projects deserve<br/><em>to be discovered.</em></h1>
    <p>Explore work from independent builders, give useful feedback, and share what you're making.</p>
    <div class="home-editorial-actions"><a class="button primary" href="/discover#project-wall">Explore projects <UiIcon name="arrow" size={16}/></a><a class="button" href="/submit-project">Share your project <UiIcon name="arrow" size={16}/></a></div>

    <a class="home-editorial-scroll" href="#featured-projects">FEATURED PROJECTS <span aria-hidden="true">↓</span></a>
  </section>
  <FeaturedProjects/>
  <ProjectTicker/>
</Platform>
