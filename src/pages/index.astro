---
import Platform from '../layouts/Platform.astro';
import UiIcon from '../components/UiIcon.astro';
import LaunchBoard from '../components/LaunchBoard.astro';
import FeedbackPoints from '../components/FeedbackPoints.astro';
import '../styles/project-wall.css';
import '../styles/home-refinement.css';
import '../styles/home-about.css';
---
<Platform title="Indie Project Directory & Weekly Launches" description="Discover indie software and tools, upvote weekly launches, and give builders feedback. Submit your own project to Digivated for free.">
  <div class="dg-home" data-spots>
    <aside class="dg-rail" data-spot-rail="0" aria-label="Featured spots"></aside>
    <div class="dg-center">
      <section class="dg-hero" aria-labelledby="dg-home-title">
        <pre class="ascii-field home-workshop dg-hero-ascii" data-ascii-field aria-hidden="true"></pre>
        <div class="dg-hero-copy">
          <p class="dg-pill"><span class="dg-dot" aria-hidden="true"></span>Weekly indie product launches</p>
          <h1 id="dg-home-title">Get your product in front of <span class="dg-hero-accent" data-site-visits-headline>visitors.</span></h1>
          <p class="dg-hero-lede">Launch free, get upvotes and real feedback from other builders.</p>
          <div class="dg-hero-actions">
            <a class="dg-btn dg-btn-primary" href="/submit-project">Submit your product <UiIcon name="arrow" size={16}/></a>
            <a class="dg-btn" href="#this-week">Browse launches</a>
          </div>
          <ul class="dg-hero-facts">
            <li>Next free launch in <time id="queue-countdown" role="timer" aria-live="off"></time></li>
            <li><strong data-stat-products>—</strong> products</li>
            <li><strong data-site-online>—</strong> browsing now</li>
          </ul>
        </div>
      </section>
      <FeedbackPoints variant="strip" cta="/discover?sort=needs" ctaLabel="Find a product to review"/>
      <p class="dg-spots-status" data-featured-status role="status" hidden></p>
      <div class="dg-spot-grid" data-spot-grid aria-label="Featured spots"></div>
      <LaunchBoard/>
    </div>
    <aside class="dg-rail" aria-label="More spots and threads">
      <div class="dg-rail-stack" data-spot-rail="1"></div>
      <section class="dg-rail-threads" data-rail-threads aria-labelledby="dg-rail-threads-title" hidden>
        <h2 id="dg-rail-threads-title"><a href="/threads">Trending threads</a></h2>
        <ol data-rail-thread-list></ol>
        <a class="dg-quiet-link" href="/threads">All threads →</a>
      </section>
    </aside>
  </div>
  <section class="dg-about" aria-labelledby="dg-about-title">
    <h2 id="dg-about-title">Discover and launch indie projects</h2>
    <p>Digivated is an indie project directory and launch community. Browse <a href="/discover">independent software and tools</a>, join the conversation in <a href="/threads">Threads</a>, or <a href="/submit-project">submit your project</a>. Launch free on a Monday by adding our badge, or pay $3 to go live right away. <a href="/about">How Digivated works →</a></p>
    <p id="how-points-work" class="dg-about-points">Feedback points: visit a product, then leave a specific comment on its page. Helpful comments earn points. Every 10 points in a week adds an upvote to your own launch. <a href="/points">How points work →</a></p>
  </section>
</Platform>

<script>
  const countdown = document.querySelector<HTMLTimeElement>('#queue-countdown');

  function updateCountdown() {
    if (!countdown) return;
    const now = new Date();
    // Free launches become eligible on Monday; the scheduled queue job
    // publishes them on Mondays at 14:00 UTC (9:00 AM Eastern).
    const daysUntilMonday = (8 - now.getUTCDay()) % 7;
    let target = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + daysUntilMonday, 14, 0);
    if (target <= now.getTime()) target += 7 * 86_400_000;

    const minutes = Math.ceil((target - now.getTime()) / 60_000);
    const days = Math.floor(minutes / 1440);
    const hours = Math.floor(minutes / 60) % 24;
    countdown.dateTime = new Date(target).toISOString();
    countdown.textContent = `${days}d ${String(hours).padStart(2, '0')}h ${String(minutes % 60).padStart(2, '0')}m`;
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>

