---
import Platform from '../../layouts/Platform.astro';
import CarouselBrowse from '../../components/CarouselBrowse.astro';
import '../../styles/founding-pass.css';
import '../../styles/carousel-library.css';
---
<Platform title="Educational carousels" description="Educational carousels on Digivated. Titles, summaries, and the first four slides are open to everyone. Existing Founding Membership purchases retain full carousel access.">
  <header class="page-intro carousel-library-intro"><p class="eyebrow">Digivated resources</p><h1>Educational carousels</h1><p class="lede">Each carousel explains one idea. The title, summary, and first four slides are open to everyone. Previous Founding Membership purchasers retain their full carousel and toolkit access.</p><div class="actions"><a class="button primary" href="/membership">Explore membership</a><a class="button" href="/membership#member-sign-in">Already purchased? Sign in</a></div><p class="quiet"><a href="/resources">← All resources</a></p></header>
  <section class="carousel-library" aria-labelledby="carousel-library-title"><h2 id="carousel-library-title" class="sr-only">Published carousels</h2><p id="carousel-index-status" class="carousel-index-status" role="status">Loading carousels…</p><CarouselBrowse/><div id="carousel-index" class="resource-grid carousel-library-grid"></div><noscript><p>Enable JavaScript to load carousel previews. Existing Founding Membership purchases retain full carousel access. <a href="/membership#previous-purchases">Previous purchases</a>.</p></noscript></section>
  <script>import '../../scripts/carousel-library.js';</script>
</Platform>
