---
import Platform from '../layouts/Platform.astro';
import UiIcon from '../components/UiIcon.astro';
import '../styles/news.css';
---
<Platform title="News" description="Member briefings on AI and technology, markets, and security, with original sources and publication times." canonicalPath="/news">
  <section class="news-page" data-news-page aria-labelledby="news-title">
    <header class="news-masthead">
      <div><p class="news-eyebrow">THE DIGIVATED BRIEFING</p><h1 id="news-title">News worth knowing.</h1><p class="news-intro">AI & tech. Markets. Security. The important developments, with the source in view.</p></div>
      <div class="news-check"><div class="news-check-status"><span data-news-checked>Checking the latest reporting</span><div class="news-countdown"><span>Next source check</span><time data-news-countdown role="timer" aria-live="off">Checking…</time></div></div><button type="button" class="news-refresh" data-news-refresh aria-label="Refresh news"><span>Refresh</span></button></div>
    </header>
    <p class="news-access-status" data-news-access-status role="status">Loading the latest reporting…</p>
    <nav class="news-toolbar" hidden aria-label="Browse News">
      <div class="news-filters" role="group" aria-label="News category">
        <button type="button" data-news-category="all" aria-pressed="true">Latest</button>
        <button type="button" data-news-category="ai-tech" aria-pressed="false">AI & Tech</button>
        <button type="button" data-news-category="markets" aria-pressed="false">Markets</button>
        <button type="button" data-news-category="security" aria-pressed="false">Security</button>
      </div>
      <label class="news-search"><UiIcon name="search" size={17}/><span class="sr-only">Search news</span><input data-news-search type="search" maxlength="120" placeholder="Search a topic, company or ticker" autocomplete="off"/></label>
    </nav>
    <div class="news-layout" hidden>
      <div class="news-editorial">
        <section class="news-feature" data-news-feature aria-label="Featured story" hidden></section>
        <section class="news-latest" aria-labelledby="news-latest-title">
          <header class="news-section-heading"><h2 id="news-latest-title" data-news-latest-title>Latest</h2><span data-news-scope>Newest first</span></header>
          <p class="news-results" data-news-results hidden role="status"></p>
          <p class="news-status" data-news-status role="status">Loading the latest stories…</p>
          <div class="news-feed" data-news-feed aria-busy="true"></div>
          <button class="news-more" data-news-more type="button" hidden>Load older stories</button>
          <a class="news-top" data-news-top href="#news-title" hidden>Back to top ↑</a>
        </section>
      </div>
      <aside class="news-sidebar" aria-label="Market data and editorial standards" data-news-sidebar>
        <section class="news-market" aria-labelledby="news-markets-title">
          <header class="news-section-heading"><h2 id="news-markets-title">Market snapshot</h2><span class="news-data-label">DATA</span></header>
          <p class="news-market-note" data-news-market-note>Checking available market data</p>
          <dl class="news-quotes" data-news-quotes></dl>
          <div class="news-market-footer" data-news-market-footer></div>
        </section>
        <details class="news-standards"><summary>How this feed is published <UiIcon name="chevron" size={15}/></summary><div><p>Stories link to the original source and show its publication time separately from the time published here.</p><p><strong>Breaking</strong> marks a significant, source-verified recent development. Regular stories are labeled <strong>Update</strong>.</p><p>Company announcements are labeled separately from independent reporting. Ticker labels come from the source. Stories without enough source support are skipped. Summaries can be corrected or removed as the reporting develops.</p></div></details>
        <p class="news-sidebar-caption">Read the original reporting for the full context.</p>
      </aside>
    </div>
    <section class="news-gate" data-news-gate hidden aria-labelledby="news-gate-title"><p class="news-eyebrow">MEMBER ACCESS</p><h2 id="news-gate-title">Go beyond the latest.</h2><p>These five stories are free. Digivated Membership opens the full News archive and market snapshot.</p><a href="/membership#member-sign-in">Unlock all News <span aria-hidden="true">↗</span></a><p>Already a member? Verify your purchase on the membership page, then return here.</p></section>
    <noscript><p class="news-status">JavaScript is needed to load and filter the News feed.</p></noscript>
  </section>
</Platform>
<script>import '../scripts/news.js';</script>
