---
import Platform from '../layouts/Platform.astro';
import UiIcon from '../components/UiIcon.astro';
import '../styles/news.css';
---
<Platform showBreadcrumb={false} title="AI, tech and markets news" description="Free, source-linked news on AI and technology, markets, and security, with original sources and publication times." canonicalPath="/news">
  <section class="news-page" data-news-page aria-labelledby="news-title">
    <header class="news-masthead">
      <div><p class="news-eyebrow">The daily briefing</p><h1 id="news-title">News</h1><p class="news-intro">What’s moving in AI, tech, markets, and security. Open any story for the quick read, then head to the source for the rest.</p></div>
      <div class="news-check"><p class="news-updated" data-news-updated hidden></p><button type="button" class="news-refresh" data-news-refresh aria-label="Refresh news"><span>Refresh</span></button></div>
    </header>
    <p class="news-status" data-news-paused hidden>Source checks are paused.</p>
    <p class="news-access-status" data-news-access-status role="status">Loading stories…</p>
    <nav class="news-toolbar" hidden aria-label="Browse News">
      <div class="news-filters" role="group" aria-label="News category">
        <button type="button" data-news-category="all" aria-pressed="true">Latest</button>
        <button type="button" data-news-category="ai-tech" aria-pressed="false">AI & Tech</button>
        <button type="button" data-news-category="markets" aria-pressed="false">Markets</button>
        <button type="button" data-news-category="security" aria-pressed="false">Security</button>
      </div>
      <label class="news-search"><UiIcon name="search" size={17}/><span class="sr-only">Search news</span><input data-news-search type="search" maxlength="120" placeholder="Search a topic, company or ticker" autocomplete="off"/></label>
    </nav>
    <div class="news-layout" hidden>
      <div class="news-editorial">
        <section class="news-lead" data-news-feature aria-label="Top story" hidden></section>
        <section class="news-latest" data-section-reveal aria-labelledby="news-latest-title">
          <header class="news-section-heading"><h2 id="news-latest-title" data-news-latest-title>Latest</h2></header>
          <p class="news-results" data-news-results hidden role="status"></p>
          <p class="news-status" data-news-status role="status">Loading the latest stories…</p>
          <div class="news-feed" data-news-feed aria-busy="true"></div>
          <button class="news-more" data-news-more type="button" hidden>Load older stories</button>
          <a class="news-top" data-news-top href="#news-title" hidden>Back to top ↑</a>
        </section>
      </div>
      <aside class="news-sidebar" aria-label="Markets" data-news-sidebar>
        <section class="news-pulse" data-section-reveal aria-labelledby="news-pulse-title">
          <header class="news-pulse-head">
            <h2 id="news-pulse-title">Markets</h2>
            <span class="news-pulse-tag">Daily</span>
          </header>
          <div class="news-pulse-block" data-news-stocks-block hidden>
            <h3 class="news-pulse-label">Stocks in the news</h3>
            <ol class="news-watch" data-news-stocks></ol>
          </div>
          <div class="news-pulse-block">
            <h3 class="news-pulse-label">Rates and the dollar</h3>
            <p class="news-market-note" data-news-market-note>Checking market data</p>
            <dl class="news-rates" data-news-quotes></dl>
          </div>
          <p class="news-pulse-foot" data-news-market-footer></p>
        </section>
        <details class="news-standards"><summary>How this feed is published <UiIcon name="chevron" size={15}/></summary><div><p>Stories link to original sources. We label company announcements, verify breaking news, and mark corrections. Stocks in the news counts companies named in recent stories. It is not a price feed or advice.</p></div></details>
      </aside>
    </div>
    <noscript><p class="news-status">JavaScript is needed to load and filter the News feed.</p></noscript>
  </section>
</Platform>
<script>import '../scripts/news.js';</script>
