---
import Platform from '../../layouts/Platform.astro';
import {resourceGroups,resourceLinkCount} from '../../data/link-resources.mjs';
import '../../styles/resource-links.css';
const label = link => { const url = new URL(link.href); return url.hostname.replace(/^www\./,'') + (url.pathname === '/' ? '' : url.pathname.replace(/\/$/,'')); };
---
<Platform title="Resources" description="A clean, searchable directory of design inspiration, creative assets, AI tools, development resources, business tools, and more." canonicalPath="/resources">
<section class="link-directory" data-link-directory aria-labelledby="links-title">
  <header class="link-directory-head">
    <p class="link-directory-kicker">THE USEFUL INTERNET, ORGANIZED</p>
    <h1 id="links-title">Resources.</h1>
    <p>Find the right place to design, build, learn, and grow. Browse by topic or search the full collection.</p>
  </header>
  <div class="link-directory-controls">
    <label class="link-directory-search"><span class="sr-only">Search resources</span><input data-link-search type="search" placeholder="Search a site or topic" autocomplete="off"/></label>
    <label class="link-directory-select-label"><span class="sr-only">Choose a category</span><select data-link-select>{resourceGroups.map(group=><option value={group.id}>{group.title}</option>)}</select></label>
  </div>
  <div class="link-directory-layout">
    <nav class="link-directory-categories" aria-label="Resource categories">{resourceGroups.map((group,index)=><button type="button" data-link-category={group.id} aria-current={index===0?'true':undefined}>{group.title}</button>)}</nav>
    <div class="link-directory-content">
      <p class="link-directory-status" data-link-status role="status">{resourceLinkCount.toLocaleString('en-US')} links across {resourceGroups.length} categories</p>
      {resourceGroups.map((group,index)=><section class="link-directory-group" data-link-group={group.id} data-link-title={group.title.toLowerCase()} hidden={index!==0} aria-labelledby={`links-${group.id}`}><header><h2 id={`links-${group.id}`}>{group.title}</h2><span>{group.links.length} links</span></header><ul>{group.links.map(link=><li data-link-item data-link-search-text={`${group.title} ${link.href}`.toLowerCase()}><a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${label(link)} in a new tab`}><span>{label(link)}</span><span aria-hidden="true">↗</span></a></li>)}</ul></section>)}
      <p class="link-directory-empty" data-link-empty hidden>No matching links. Try another search or category.</p>
    </div>
  </div>
</section>
</Platform>
<script>import '../../scripts/resource-links.js';</script>
