---
import Platform from '../layouts/Platform.astro';
import '../styles/project-account.css';
---
<Platform title="Creator profile" description="Meet builders and explore their published projects on Digivated.">
  <section class="creator-public" aria-labelledby="creator-title"><a class="creator-back" href="/creators">← Explore creators</a><div class="creator-cover" aria-hidden="true"><span>BUILD IN PUBLIC · DIGIVATED</span></div><div class="creator-public-intro"><span class="creator-avatar" id="creator-avatar" aria-hidden="true">D</span><div><p class="eyebrow">DIGIVATED CREATOR</p><h1 id="creator-title">Creator profile</h1><p id="creator-bio"></p><div class="creator-profile-links"><a id="creator-website" hidden target="_blank" rel="noopener noreferrer">Website ↗</a><a id="creator-social" hidden target="_blank" rel="noopener noreferrer">Social ↗</a></div><p class="creator-followers" id="creator-followers"></p><div class="creator-profile-actions"><button class="button primary" id="creator-follow" type="button" hidden>Follow</button><button class="button" id="creator-share" type="button">Share profile</button></div><p id="creator-action-status" role="status"></p></div></div><p id="creator-public-status" role="status">Loading profile…</p><nav class="creator-tabs" aria-label="Creator profile sections"><span class="active">Activity</span><a href="/creators">Discover creators</a></nav><h2 id="creator-projects-title" hidden>Recent activity</h2><div id="creator-projects" class="creator-projects"></div></section>
  <script>import '../scripts/creator-profile.js';</script>
</Platform>
