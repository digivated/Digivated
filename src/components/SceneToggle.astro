---
const { footer = false } = Astro.props;
---
<button class:list={['dg-scene-toggle', { 'dg-footer-motion': footer }]} type="button" data-scene-toggle aria-label="Pause animation" hidden>
  <span class="dg-scene-pause" aria-hidden="true"></span>
  <span class="dg-scene-play" aria-hidden="true"></span>
</button>
