---
import LaunchEffect from './preview/LaunchEffect.astro';
import '../styles/discovery-hero.css';
---
<section class="dg-hero dg-home-hero" aria-labelledby="dg-home-title" data-discovery-hero>
  <div class="dg-hero-copy">
    <LaunchEffect name="headline"/>
    <p class="dg-hero-lede">Discover useful products from independent makers. Launch your own for free.</p>
    <div class="dg-hero-actions">
      <LaunchEffect name="action"/>
      <a class="dg-btn dg-hero-secondary" href="/submit-project">Submit your product</a>
    </div>
  </div>
  <LaunchEffect name="art" class="dg-preview-art-frame" decorative/>
</section>
