---
import UiIcon from './UiIcon.astro';
import '../styles/discovery-hero.css';
---

<section class="dg-hero dg-home-hero" aria-labelledby="dg-home-title" data-discovery-hero>
  <div class="dg-hero-copy">
    <h1 id="dg-home-title">Discover indie <span>launches.</span></h1>
    <p class="dg-hero-lede">See what independent makers are building, or put your own product on the board.</p>
    <div class="dg-hero-actions">
      <form class="dg-launch-search" action="/discover" method="get" role="search" aria-label="Find a product">
        <UiIcon name="search" size={18}/>
        <label class="sr-only" for="dg-launch-search">Search products or makers</label>
        <input type="search" id="dg-launch-search" name="q" placeholder="Find a product or maker" maxlength="120" autocomplete="off" enterkeyhint="search"/>
        <button type="submit" aria-label="Search products"><UiIcon name="arrow" size={16}/></button>
      </form>
      <a class="dg-btn dg-btn-primary" href="#this-week">Browse launches <UiIcon name="arrow" size={16}/></a>
      <a class="dg-btn dg-hero-secondary" href="/submit-project">Submit your product</a>
    </div>
  </div>
</section>
