---
import UiIcon from './UiIcon.astro';
---

<section class="dg-home-hero" aria-labelledby="dg-home-title" data-discovery-hero>
  <div class="launch-welcome">
    <h1 id="dg-home-title">Discover product launches</h1>
    <p class="board-introduction">See what makers are shipping.</p>
    <div class="dg-hero-actions">
      <form class="dg-launch-search" action="/discover" method="get" role="search" aria-label="Find a product" data-launch-search>
        <UiIcon name="search" size={18}/>
        <label class="sr-only" for="dg-launch-search">Search products or makers</label>
        <input type="search" id="dg-launch-search" name="q" placeholder="Search launches" maxlength="120" autocomplete="off" enterkeyhint="search"/>
        <button type="button" data-clear-launch-search aria-label="Clear launch search" hidden><UiIcon name="close" size={16}/></button>
        <button type="submit" aria-label="Search products"><UiIcon name="arrow" size={16}/></button>
      </form>
      <a class="dg-btn dg-btn-primary" href="/submit-project">New Launch <UiIcon name="arrow" size={15}/></a>
    </div>
    <p class="dg-launch-search-status" data-launch-search-status role="status" hidden></p>
  </div>
</section>

<script>
  import { foldText } from '../scripts/fold-text.js';
  // Title unfolds first; the smaller line follows a little faster and gentler.
  foldText(document.getElementById('dg-home-title'));
  foldText(document.querySelector<HTMLElement>('[data-discovery-hero] .board-introduction'), { splitBy: 'word', delay: 450, stagger: 70, duration: 560, foldAngle: 80, refoldAngle: 30, refoldRadius: 110 });
</script>
