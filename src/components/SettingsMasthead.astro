---
import '../styles/settings-masthead.css';

// Plain page heading for settings screens: title, one line of context, optional actions.
// (The animated dark banner was retired in the clean redesign, Nov 22, 2026.)
const { id, title, description, level = 'h2' } = Astro.props;
const Heading = level;
---
<header class="settings-masthead settings-masthead-plain">
  <div class="settings-masthead-copy">
    <Heading id={id}>{title}</Heading>
    {description && <p>{description}</p>}
  </div>
  {Astro.slots.has('default') && <div class="settings-masthead-actions"><slot/></div>}
</header>
