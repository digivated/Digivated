---
import '../styles/launch-scenes.css';

const { mode = 'orbit', size = 'masthead' } = Astro.props;
---
<div class:list={['dg-launch-scene', `dg-launch-scene-${size}`]} data-launch-scene={mode} data-scene-size={size} aria-hidden="true">
  <img class="dg-scene-poster" src={`/media/launch-${mode}.webp`} width="640" height="560" alt="" loading={size === 'hero' ? 'eager' : 'lazy'} decoding="async"/>
  <canvas></canvas>
</div>

<script>import '../scripts/launch-scenes.js';</script>
