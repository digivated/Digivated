---
import type { Rocket01Icon } from '@hugeicons/core-free-icons';

interface Props {
  icon: typeof Rocket01Icon;
}
const { icon } = Astro.props;
---
<svg class="site-menu-glyph" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {icon.map(([Element, { key: _, strokeWidth, strokeLinecap, strokeLinejoin, ...attributes }]) => (
    <Element {...attributes} stroke-width={strokeWidth} stroke-linecap={strokeLinecap} stroke-linejoin={strokeLinejoin}/>
  ))}
</svg>
