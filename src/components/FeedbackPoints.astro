---
// Feedback points, explained where makers will see it. `full` shows the three
// steps and the visitor's own progress; `strip` is one line that opens the steps.
import { BOOST_POINTS_PER_VOTE, REVIEW_MIN_SECONDS, DAILY_POINT_CAP } from '../lib/feedback-score.mjs';
import '../styles/feedback-points.css';
const { variant = 'full', heading = 'Help other makers. Lift your own launch.', cta = '/discover?sort=needs', ctaLabel = 'Find a product to review' } = Astro.props;
const id = `fp-${Math.random().toString(36).slice(2, 8)}`;
const steps = [
  ['Visit', `Open a product with its Visit button. Stay ${REVIEW_MIN_SECONDS} seconds or more.`],
  ['Comment', 'Come back and say something specific. +5 points, or +10 for a detailed note.'],
  ['Climb', `Every ${BOOST_POINTS_PER_VOTE} points this week adds an upvote to your launch.`],
];
---
{variant === 'strip' ? (
  <details class="dg-fp dg-fp-strip" data-feedback-points>
    <summary><span class="dg-fp-spark" aria-hidden="true">✦</span><span class="dg-fp-strip-copy"><strong>Feedback points</strong><span>Review other launches. Earn upvotes for yours.</span></span><span class="dg-fp-me" data-fp-me hidden></span><span class="dg-fp-toggle" aria-hidden="true">+</span></summary>
    <ol class="dg-fp-steps">{steps.map(([t, d]) => <li><strong>{t}</strong><p>{d}</p></li>)}</ol>
    <p class="dg-fp-foot"><a class="dg-btn dg-btn-primary" href={cta}>{ctaLabel} →</a><a class="dg-quiet-link" href="/points">How it works</a></p>
  </details>
) : (
  <section class="dg-fp dg-fp-full" aria-labelledby={id} data-feedback-points>
    <header class="dg-fp-head">
      <p class="dg-label"><span class="dg-fp-spark" aria-hidden="true">✦</span> Feedback points</p>
      <span class="dg-fp-me" data-fp-me hidden></span>
    </header>
    <h2 id={id}>{heading}</h2>
    <ol class="dg-fp-steps">{steps.map(([t, d]) => <li><strong>{t}</strong><p>{d}</p></li>)}</ol>
    <div class="dg-fp-progress" data-fp-progress hidden>
      <span class="dg-fp-bar" aria-hidden="true" data-fp-bar>[□□□□□□□□□□]</span>
      <span data-fp-progress-copy></span>
    </div>
    <p class="dg-fp-foot">
      <a class="dg-btn dg-btn-primary" href={cta}>{ctaLabel} →</a>
      <a class="dg-btn" href="/login?mode=signup&next=%2Fdiscover%3Fsort%3Dneeds" data-fp-signin>Sign up to earn</a>
      <a class="dg-quiet-link" href="/points">How it works</a>
    </p>
    <p class="dg-fp-fine">Once per product. Up to {DAILY_POINT_CAP} points a day.</p>
  </section>
)}
<script>import '../scripts/feedback-points-card.js';</script>
