---
// Feedback points, explained where makers will see it. `full` shows the three
// steps and the visitor's own progress; `strip` is one line that opens the steps.
import { BOOST_POINTS_PER_VOTE, REVIEW_MIN_SECONDS, DAILY_POINT_CAP } from '../lib/feedback-score.mjs';
import '../styles/feedback-points.css';
const { variant = 'full', heading = 'Help other makers. Lift your own launch.', cta = '/discover?sort=needs', ctaLabel = 'Find a product that needs feedback' } = Astro.props;
const id = `fp-${Math.random().toString(36).slice(2, 8)}`;
const steps = [
  ['↗', 'Visit a launch', `Hit Visit and look around for ${REVIEW_MIN_SECONDS}+ seconds.`],
  ['✎', 'Leave feedback', 'Be specific. +5 points, or +10 for a detailed one.'],
  ['▲', 'Get bonus upvotes', `Every ${BOOST_POINTS_PER_VOTE} points this week adds an upvote to yours.`],
];
---
{variant === 'strip' ? (
  <details class="dg-fp dg-fp-strip" data-feedback-points>
    <summary><span class="dg-fp-icon" aria-hidden="true"><span class="dg-fp-spark">✦</span></span><span class="dg-fp-strip-copy"><strong>Feedback points</strong> <span>Review launches, earn upvotes for yours.</span></span><span class="dg-fp-me" data-fp-me hidden></span><span class="dg-fp-toggle"><span class="dg-fp-toggle-text">How it works</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></span></summary>
    <ol class="dg-fp-steps">{steps.map(([n, t, d]) => <li><span class="dg-fp-n" aria-hidden="true">[ {n} ]</span><strong>{t}</strong><p>{d}</p></li>)}</ol>
    <p class="dg-fp-foot"><a class="dg-btn dg-btn-primary" href={cta}>{ctaLabel} →</a><a class="dg-quiet-link" href="/points">How points work</a></p>
  </details>
) : (
  <section class="dg-fp dg-fp-full" aria-labelledby={id} data-feedback-points>
    <header class="dg-fp-head">
      <p class="dg-label"><span class="dg-fp-spark" aria-hidden="true">✦</span> Feedback points</p>
      <span class="dg-fp-me" data-fp-me hidden></span>
    </header>
    <h2 id={id}>{heading}</h2>
    <ol class="dg-fp-steps">{steps.map(([n, t, d]) => <li><span class="dg-fp-n" aria-hidden="true">[ {n} ]</span><strong>{t}</strong><p>{d}</p></li>)}</ol>
    <div class="dg-fp-progress" data-fp-progress hidden>
      <span class="dg-fp-bar" aria-hidden="true" data-fp-bar>[□□□□□□□□□□]</span>
      <span data-fp-progress-copy></span>
    </div>
    <p class="dg-fp-foot">
      <a class="dg-btn dg-btn-primary" href={cta}>{ctaLabel} →</a>
      <a class="dg-btn" href="/login?mode=signup&next=%2Fdiscover%3Fsort%3Dneeds" data-fp-signin>Sign up to start earning</a>
      <a class="dg-quiet-link" href="/points">How points work</a>
    </p>
    <p class="dg-fp-fine">Once per product · up to {DAILY_POINT_CAP} points a day · links and spam earn nothing.</p>
  </section>
)}
<script>import '../scripts/feedback-points-card.js';</script>
