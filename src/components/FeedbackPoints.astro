---
import { BOOST_POINTS_PER_VOTE, REVIEW_MIN_SECONDS, DAILY_POINT_CAP } from '../lib/feedback-score.mjs';
import '../styles/feedback-points.css';
const { heading = 'Help other makers. Lift your own launch.', cta = '/discover?sort=needs', ctaLabel = 'Find a product that needs feedback' } = Astro.props;
const id = `fp-${Math.random().toString(36).slice(2, 8)}`;
// A short pipeline: glyph on the rail, what to do, and what it's worth.
const steps = [
  ['↗', 'Visit a launch', 'Hit Visit and look around for a bit.', `≥ ${REVIEW_MIN_SECONDS}s`],
  ['✎', 'Leave feedback', 'Say what worked and what didn’t.', '+5 / +10 pts'],
  ['▲', 'Get bonus upvotes', 'Points this week lift your own launch.', `▲ +1 per ${BOOST_POINTS_PER_VOTE}`],
];
const pipeline = steps.map(([glyph, title, copy, reward]) => ({ glyph, title, copy, reward }));
---
<section class="dg-fp dg-fp-full" aria-labelledby={id} data-feedback-points>
  <header class="dg-fp-head">
    <p class="dg-label"><span class="dg-fp-spark" aria-hidden="true">✦</span> Feedback points</p>
    <span class="dg-fp-me dg-fp-meter" data-fp-me hidden><span class="dg-fp-meter-top"><b data-fp-count>0</b><small data-fp-goal>/ {BOOST_POINTS_PER_VOTE} to ▲</small></span><span class="dg-fp-meter-bar" data-fp-cells aria-hidden="true"></span></span>
  </header>
  <h2 id={id}>{heading}</h2>
  <ol class="dg-fp-steps">{pipeline.map(step => <li class="dg-fp-step"><span class="dg-fp-node" aria-hidden="true">{step.glyph}</span><span class="dg-fp-step-copy"><strong>{step.title}</strong><span>{step.copy}</span></span><span class="dg-fp-reward">{step.reward}</span></li>)}</ol>
  <div class="dg-fp-progress" data-fp-progress hidden>
    <span class="dg-fp-meter-bar dg-fp-bar" aria-hidden="true" data-fp-bar></span>
    <span data-fp-progress-copy></span>
  </div>
  <p class="dg-fp-foot">
    <a class="dg-btn dg-btn-primary" href={cta}>{ctaLabel} →</a>
    <a class="dg-btn" href="/login?mode=signup&next=%2Fdiscover%3Fsort%3Dneeds" data-fp-signin>Sign up to start earning</a>
  </p>
  <p class="dg-fp-fine">Once per product · up to {DAILY_POINT_CAP} points a day · links and spam earn nothing.</p>
</section>
<script>import '../scripts/feedback-points-card.js';</script>
