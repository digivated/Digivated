---
import UiIcon from './UiIcon.astro';
const { ai=false }=Astro.props;
---
<section class:list={['launch-directory',{'rankings-directory':!ai}]} data-launch-directory data-ai={String(ai)}>
 {ai ? <header class="launch-heading"><p class="launch-eyebrow">THE DIGIVATED DIRECTORY</p><h1>AI Tools</h1><p>Browse AI tools by category. Explore real projects, meet their makers, and find the right tool for your next idea.</p></header> :
 <header class="rankings-hero"><div><p class="launch-eyebrow">THE COMMUNITY LEADERBOARD</p><h1>Built by people.<br/><span>Ranked by you.</span></h1></div><div class="rankings-hero-copy"><p>Independent ideas. Real builders.<br/>Discover something worth your upvote.</p><div class="launch-links"><a href="/submit-project">Put your project on the board <UiIcon name="external" size={16}/></a><a href="/discover">Explore all projects</a><a href="/resources">Resources</a></div></div></header>}
 {!ai&&<section class="ranking-personal" aria-labelledby="ranking-personal-title"><div class="ranking-personal-heading"><p class="rankings-section-label">YOUR BOARD</p><h2 id="ranking-personal-title">Your picks <span data-ranking-picks-count></span></h2><p>Projects you’ve upvoted on this device.</p></div><div class="ranking-personal-list" data-ranking-picks><span>Upvote a project to keep it close.</span></div><div class="ranking-personal-share"><button class="ranking-share" type="button" data-ranking-share>Share rankings <UiIcon name="external" size={14}/></button><span data-ranking-share-status role="status"></span></div></section>}
 <div class="launch-toolbar"><div hidden={ai} role="group" aria-label="Ranking period" class="launch-periods"><button data-period="daily" aria-pressed="true">Today</button><button data-period="weekly" aria-pressed="false">This week</button><button data-period="monthly" aria-pressed="false">This month</button><button data-period="all" aria-pressed="false">All time</button></div><label><span class="sr-only">Search projects</span><input data-launch-search type="search" placeholder="Search projects or builders"/></label></div>
 <div class="launch-categories" data-launch-categories role="group" aria-label="Filter category"></div>
 <div class="ai-category-grid" data-ai-overview hidden></div>
 <div class="launch-list-heading" data-list-heading>{ai ? <><h2 data-ranking-title>AI tools</h2><span data-launch-total></span></> : <><div><p class="rankings-section-label">THE BOARD</p><h2 data-ranking-title>Today's rankings</h2></div><div class="rankings-totals"><span data-launch-total></span><span data-ranking-votes></span></div></>}</div>
 <div class="rankings-context" hidden={ai}><p data-ranking-context>Upvotes received today · resets at 00:00 UTC</p><details><summary>How rankings work</summary><p>Ranked by upvotes received in the selected period. Daily resets at 00:00 UTC; weeks start Monday. Period tracking began November 1, 2026. Existing votes are preserved in all-time totals. Ties are ordered by newest project, then project ID.</p></details></div>
 <p role="status" data-launch-status>Loading projects…</p><ol class="launch-list" data-launch-list aria-label={ai?'AI tools':'Ranked projects'}></ol><button class="button" data-launch-more hidden>Show more</button>
</section>
<script>import '../scripts/launch-directory.js';</script>
<style is:global>
.launch-directory{max-width:1120px;margin:0 auto;padding:48px 24px 80px;color:#202528}
.launch-heading{max-width:760px;margin-bottom:36px}.launch-eyebrow{font-size:10px;letter-spacing:.16em;font-weight:700;color:#737b80}.launch-heading h1{font-size:clamp(32px,5vw,54px);line-height:1.12;letter-spacing:-.05em;margin:12px 0 16px}.launch-heading>p:not(.launch-eyebrow){color:#677077;max-width:620px;line-height:1.7}.launch-links{display:flex;gap:20px;flex-wrap:wrap;margin-top:22px}.launch-links a{font-size:13px;color:#596269;text-decoration:none}.launch-links a[aria-current]{color:#111;font-weight:750}
.launch-toolbar{display:flex;justify-content:space-between;gap:16px;padding:18px 0;border-top:1px solid #e1e4e6}.launch-periods{display:flex;gap:4px;flex-wrap:wrap}.launch-directory button{cursor:pointer}.launch-periods button,.launch-categories button{border:1px solid transparent;border-radius:7px;background:transparent;color:#616a70;padding:9px 13px;font:inherit;font-size:12px}.launch-periods button[aria-pressed=true]{background:#22282c;color:white}.launch-toolbar input{width:240px;max-width:100%;padding:10px 14px;border:1px solid #dde1e3;border-radius:8px;background:white;font:inherit;font-size:13px}.launch-categories{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:26px}.launch-categories button{border-color:#e1e4e6;background:#fff}.launch-categories button[aria-pressed=true]{border-color:#293238;color:#111;background:#eef0f1}
.launch-list-heading{display:flex;align-items:center;justify-content:space-between;gap:12px}.launch-list-heading h2{font-size:21px;letter-spacing:-.025em}.launch-list-heading>span,.launch-note{font-size:12px;color:#788087}.launch-note{line-height:1.65;margin-bottom:20px;max-width:760px}.launch-list{list-style:none;padding:0;margin:0 0 24px}.launch-row{display:grid;grid-template-columns:26px 64px minmax(0,1fr) 70px;gap:18px;align-items:center;padding:24px 0;border-top:1px solid #e3e6e8}.launch-rank{font-size:13px;color:#879096;font-variant-numeric:tabular-nums}.launch-logo{width:64px;height:64px;object-fit:contain;border:1px solid #e3e6e8;background:white;border-radius:12px}.launch-copy h3{margin:0 0 7px;font-size:17px;letter-spacing:-.02em}.launch-copy a{color:inherit;text-decoration:none}.launch-copy a:hover{text-decoration:underline}.launch-copy p{font-size:13px;line-height:1.6;color:#606a71;margin:0 0 9px}.launch-meta{display:flex;gap:12px;flex-wrap:wrap;font-size:11px;color:#7b858c}.launch-vote{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;border:1px solid #dce1e4;border-radius:9px;min-height:62px;background:#fff;color:#303a40;font-size:13px;font-weight:700}.launch-vote[aria-pressed=true]{color:#fff;background:#252d32;border-color:#252d32}.launch-vote:disabled{opacity:.6}.launch-directory :focus-visible{outline:2px solid #495c69;outline-offset:3px}
@media(max-width:600px){.launch-directory{padding:28px 18px 56px}.launch-toolbar{flex-direction:column}.launch-toolbar input{width:100%}.launch-toolbar label{width:100%}.launch-row{grid-template-columns:18px 44px minmax(0,1fr) 52px;gap:10px;padding:20px 0}.launch-logo{width:44px;height:44px;border-radius:9px}.launch-copy h3{font-size:15px}.launch-copy p{font-size:12px}.launch-vote{min-height:56px}.launch-periods button{padding:9px 11px}}
</style>

<style is:global>
.launch-directory [hidden]{display:none!important}.launch-copy p{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.ai-category-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin:24px 0 40px}.ai-category-card{display:flex;flex-direction:column;padding:24px;border:1px solid #e0e4e6;border-radius:12px;background:white;min-width:0;text-decoration:none;color:#202528}.ai-category-card:hover{border-color:#929da4;box-shadow:0 4px 16px #20252808}.ai-category-card h2{font-size:18px!important;letter-spacing:-.02em;margin:0 0 8px!important}.ai-category-card>p{font-size:12px;color:#737e86;line-height:1.6;min-height:38px}.ai-category-count{font-size:11px;color:#78838a;margin:12px 0}.ai-category-preview{display:flex;gap:10px;align-items:center;border-top:1px solid #eef0f1;padding:12px 0;min-width:0}.ai-category-preview img{width:30px;height:30px;object-fit:contain;border-radius:6px}.ai-category-preview span{font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ai-category-card>b{font-size:12px;margin-top:auto;padding-top:16px}.ai-directory-return{font-size:12px;color:#515d65}@media(max-width:900px){.ai-category-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:580px){.ai-category-grid{grid-template-columns:1fr}.ai-category-card{padding:20px}}
</style>
