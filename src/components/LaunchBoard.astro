---
import UiIcon from './UiIcon.astro';

// Rows are rendered by home-board.js from
// /api/projects?ranking=1 (this week, earlier), /api/launches?view=podium (last
// week's final results) and /api/launches?view=upcoming (launching next).
const sections = [
  { key: 'current', id: 'this-week', title: 'This week’s launches', live: true },
  { key: 'upcoming', id: 'launching-next', title: 'Launching next', live: false, more: '/submit-project', moreLabel: 'Get a free launch date' },
  { key: 'previous', id: 'last-week', title: 'Last week’s launches', live: false },
  { key: 'top', id: 'top-voted', title: 'Top voted', live: false },
  { key: 'archive', id: 'earlier', title: 'Earlier launches', live: false, more: '/discover', moreLabel: 'Browse the directory' },
];
---
<div class="board-filters" data-board-filters hidden>
  <div class="board-sort" role="group" aria-label="Sort launches">
    <button type="button" data-board-sort="recent" aria-pressed="true">Most recent</button>
    <button type="button" data-board-sort="top" aria-pressed="false">Top voted</button>
    <span data-board-results aria-live="polite"></span>
  </div>
  <div class="board-category-bar">
    <div class="board-categories" role="group" aria-label="Filter by category" data-board-categories></div>
    <a class="board-all-categories" href="/categories">All Categories <UiIcon name="external" size={13}/></a>
  </div>
</div>
<div class="dg-board" data-board>
  {sections.map(section => (<>
    <section id={section.id} class="dg-list" data-section-reveal data-board-section={section.key} aria-labelledby={`dg-list-${section.key}`} hidden={section.key === 'upcoming' || section.key === 'top'}>
      <header class="dg-list-head">
        <h2 id={`dg-list-${section.key}`}><span class="dg-list-title">{section.title}</span></h2>

        <span class="dg-list-count" data-section-count></span>
      </header>
      <p class="dg-list-note" data-section-note>{section.key === 'upcoming' ? '' : 'Loading launches…'}</p>
      <ul class="dg-list-rows dg-project-list" data-section-list>
        {section.key !== 'upcoming' && Array.from({ length: section.key === 'current' ? 4 : 2 }, () => <li class="dg-row is-loading" aria-hidden="true"><span class="dg-logo"></span><span class="dg-main"></span></li>)}
      </ul>
      <div class="dg-list-foot">
        <button type="button" class="dg-more" data-section-more hidden>View more</button>
        {section.more && <a class="dg-quiet-link" href={section.more}>{section.moreLabel} <span aria-hidden="true">→</span></a>}
      </div>
    </section>
    {section.live && (
      <section class="dg-rising" data-section-reveal data-rising hidden aria-labelledby="dg-rising-title">
        <header class="dg-rising-head">
          <h2 id="dg-rising-title"><span class="dg-rising-arrow" aria-hidden="true">↗</span> Rising now</h2>
          <p class="dg-rising-sub">Most active in the past 24 hours</p>
        </header>
        <ol class="dg-rising-list" data-rising-list></ol>
      </section>
    )}
  </>))}
  <noscript><p><a href="/discover">Browse the product directory.</a></p></noscript>
</div>
<script>import '../scripts/home-board.js'; import '../scripts/visit-feedback.js';</script>
