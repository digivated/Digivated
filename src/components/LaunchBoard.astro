---
import UiIcon from './UiIcon.astro';

// Rows are rendered by home-board.js from
// /api/projects?ranking=1 (this week, earlier), /api/launches?view=podium (last
// week's final results) and /api/launches?view=upcoming (launching next).
const sections = [
  { key: 'current', id: 'this-week', navLabel: 'This week', title: 'This week’s launches', live: true },
  { key: 'upcoming', id: 'launching-next', navLabel: 'Upcoming', title: 'Launching next', live: false, more: '/submit-project', moreLabel: 'Get a free launch date' },
  { key: 'previous', id: 'last-week', navLabel: 'Last week', title: 'Last week’s launches', live: false, more: '/winners', moreLabel: 'See weekly winners' },
  { key: 'archive', id: 'earlier', navLabel: 'Earlier', title: 'Earlier launches', live: false, more: '/discover', moreLabel: 'Browse the directory' },
];
---
<div class="board-filters" data-board-filters hidden>
  <div class="board-sort" role="group" aria-label="Sort launches">
    <button type="button" data-board-sort="recent" aria-pressed="true">Most recent</button>
    <button type="button" data-board-sort="ranked" aria-pressed="false">Board ranking</button>
  </div>
  <div class="board-categories" role="group" aria-label="Filter by category" data-board-categories></div>
</div>
<nav class="dg-launch-nav" aria-label="Browse launches">
  {sections.map(section => <a href={`#${section.id}`}>{section.navLabel}</a>)}
  <a href="/categories">Browse by category <UiIcon name="external" size={13}/></a>
</nav>
<div class="dg-board" data-board>
  {sections.map(section => (<>
    <section id={section.id} class="dg-list" data-section-reveal data-board-section={section.key} aria-labelledby={`dg-list-${section.key}`} hidden={section.key === 'upcoming'}>
      <header class="dg-list-head">
        <h2 id={`dg-list-${section.key}`}>{section.live && <span class="dg-dot" aria-hidden="true"></span>}<span class="dg-list-title">{section.title}</span></h2>

        <span class="dg-list-count" data-section-count></span>
        {section.live && <a class="dg-points" href="/points" data-points-chip><span aria-hidden="true">✦</span> <span data-points-label>Feedback points</span><span hidden data-points-have><strong data-points-total>0</strong> pts</span><span class="sr-only"> How feedback points work.</span></a>}
      </header>
      <p class="dg-list-note" data-section-note>{section.key === 'upcoming' ? '' : 'Loading launches…'}</p>
      <ul class="dg-list-rows" data-section-list>
        {section.key !== 'upcoming' && Array.from({ length: section.key === 'current' ? 4 : 2 }, () => <li class="dg-row is-loading" aria-hidden="true"><span class="dg-logo"></span><span class="dg-main"></span></li>)}
      </ul>
      <div class="dg-list-foot">
        <button type="button" class="dg-more" data-section-more hidden>View more</button>
        {section.more && <a class="dg-quiet-link" href={section.more}>{section.moreLabel} <span aria-hidden="true">→</span></a>}
      </div>
    </section>
    {section.live && (
      <section class="dg-rising" data-section-reveal data-rising hidden aria-labelledby="dg-rising-title">
        <header class="dg-rising-head">
          <h2 id="dg-rising-title"><span class="dg-rising-arrow" aria-hidden="true">↗</span> Rising now</h2>
          <p class="dg-rising-sub">Most active in the past 24 hours</p>
          <a class="dg-quiet-link dg-rising-how" href="/winners#how-ranking-works">How ranking works <span aria-hidden="true">→</span></a>
        </header>
        <ol class="dg-rising-list" data-rising-list></ol>
      </section>
    )}
  </>))}
  <noscript><p><a href="/discover">Browse the product directory.</a></p></noscript>
</div>
<script>import '../scripts/home-board.js'; import '../scripts/visit-feedback.js';</script>
