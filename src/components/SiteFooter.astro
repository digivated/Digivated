---
import { footerGroups } from '../data/site-navigation.mjs';
import UiIcon from './UiIcon.astro';
import BugReport from './BugReport.astro';
import '../styles/site-footer.css';

const bugHref = 'mailto:digivatedbiz@gmail.com?subject=Digivated%20bug%20report';
const groups = footerGroups.filter(group => group.title !== 'Follow');
const socials = footerGroups.find(group => group.title === 'Follow')?.links ?? [];
---
<footer class="dg-site-footer">
  <div class="dg-footer-inner">
    <div class="dg-footer-intro">
      <a class="dg-footer-brand" href="/">
        <img class="daylight-brand-mark" src="/digivated-daylight-mark.png" width="32" height="32" alt=""/>
        Digivated
      </a>
      <div class="dg-footer-digest">
        <div><h2>Weekly launch email</h2><p>Get new projects in your inbox.</p></div>
        <a class="dg-footer-email-link" href="/account?tab=settings">Email settings <UiIcon name="external" size={14}/></a>
      </div>
    </div>
      <nav class="dg-footer-groups" aria-label="Footer">
        {groups.map(group => <div class="dg-footer-group">
          <h2>{group.title}</h2>
          <ul>
            {group.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
            {group.title === 'Company' && <li><a href={bugHref} data-bug-open>Report a bug</a></li>}
          </ul>
        </div>)}
      </nav>
    <div class="dg-footer-bottom">

        <div class="dg-footer-feature"><span>Featured on</span><a class="dg-footer-credit" href="https://launchai.tools" target="_blank" rel="noopener noreferrer" data-launchai-badge="featured" aria-label="Featured on LaunchAI: Digivated">
          <img src="/media/launchai-rocket-mark.png" alt="" width="18" height="18" loading="lazy" decoding="async"/>
          LaunchAI
        </a></div>
        <nav class="dg-footer-utility" aria-label="Digivated social links">
          {socials.map(([href, label]) => <a href={href} target="_blank" rel="noopener noreferrer">{label}</a>)}
        </nav>

      <small>© {new Date().getFullYear()} Digivated</small>
    </div>
  </div>
</footer>
<BugReport/>
