---
const { compact = false } = Astro.props;
const groups = [
  { title:'Explore', links:[['Projects','/discover'],['Rankings','/rankings'],['AI Tools','/ai-tools']] },
  { title:'Community', links:[['Submit a Project','/submit-project'],['Your Projects','/account'],['Saved Items','/saved'],['Membership','/membership']] },
  { title:'Digivated', links:[['About','/about']] },
  { title:'Connect', links:[['X / Twitter','https://x.com/digivatedx'],['Threads','https://www.threads.com/@digivated'],['Instagram','https://www.instagram.com/digivated/'],['Pinterest','https://www.pinterest.com/digivated/']] },
  { title:'Legal', links:[['Privacy & Data','/privacy'],['Terms of Use','/terms']] },
];
---
{compact ? <footer class="compact-home-footer"><span>© {new Date().getFullYear()} Digivated.</span><nav aria-label="Footer"><a href="/about">About</a><a href="https://x.com/digivatedx" target="_blank" rel="noopener noreferrer">Contact on X</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></nav></footer> : <footer class="platform-footer">
  <div class="footer-inner mx-auto px-6"><div class="footer-columns">
    <div class="footer-intro"><a class="platform-brand" href="/"><span class="x-brand-mark" aria-hidden="true"></span>Digivated</a><p>Useful tools and independent projects, in one place.</p></div>
    {groups.map(group => <nav class={`footer-group-${group.title.toLowerCase()}`} aria-label={`${group.title} footer links`}><h2>{group.title}</h2><div class="footer-group-links">{group.links.map(([label, href]) => <a href={href} target={href.startsWith('https:') ? '_blank' : undefined} rel={href.startsWith('https:') ? 'noopener noreferrer' : undefined}>{label}</a>)}</div></nav>)}
  </div><div class="footer-bottom flex flex-wrap items-center justify-between gap-4"><span>© {new Date().getFullYear()} Digivated.</span><span>Keep looking forward.</span></div></div>
</footer>}
