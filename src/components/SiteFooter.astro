---
import { footerGroups } from '../data/site-navigation.mjs';
import BugReport from './BugReport.astro';
const bugHref = 'mailto:digivatedbiz@gmail.com?subject=Digivated%20bug%20report';
const { compact = false } = Astro.props;

---
{compact ? <footer class="compact-home-footer"><span>© {new Date().getFullYear()} Digivated.</span><nav aria-label="Footer"><a href="/about">About</a><a href="https://x.com/digivatedx" target="_blank" rel="noopener noreferrer">Contact on X</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href={bugHref} data-bug-open>Report a bug</a></nav></footer> : <footer class="platform-footer">
  <div class="footer-inner mx-auto px-6"><div class="footer-columns">
    <div class="footer-intro"><a class="platform-brand" href="/"><span class="brand-spinner" aria-hidden="true"><img class="new-brand-mark brand-spinner-front" src="/digivated-ascii-icon-transparent.png" width="40" height="40" alt=""/><img class="new-brand-mark brand-spinner-back" src="/digivated-ascii-icon-transparent.png" width="40" height="40" alt=""/></span>Digivated</a><p>Useful tools and independent projects, in one place.</p></div>
    {footerGroups.map(group => <nav class={`footer-group-${group.title.toLowerCase().replaceAll(' ', '-')}`} aria-label={`${group.title} footer links`}><h2>{group.title}</h2><div class="footer-group-links">{group.links.map(([href, label]) => <a href={href} target={href.startsWith('https:') ? '_blank' : undefined} rel={href.startsWith('https:') ? 'noopener noreferrer' : undefined}>{label}</a>)}{group.title === 'Digivated' && <a href={bugHref} data-bug-open>Report a bug</a>}</div></nav>)}
  </div><div class="footer-bottom flex flex-wrap items-center justify-between gap-4"><span>© {new Date().getFullYear()} Digivated.</span><span>Keep looking forward.</span></div>
  <div class="launchai-featured"><a href="https://launchai.tools" target="_blank" rel="noopener" data-launchai-badge="featured" aria-label="Featured on LaunchAI: Digivated"><span aria-hidden="true"><img src="https://launchai.tools/brand/launchai-rocket-mark-web.png" alt="" width="34" height="34" loading="lazy" decoding="async" /></span><span><span>Featured on</span><strong>LaunchAI</strong></span></a></div></div>
</footer>}
<BugReport />
<style>
  .launchai-featured{display:flex;justify-content:center;width:100%;margin:16px 0 0;padding:0}
  .launchai-featured [data-launchai-badge="featured"]{display:inline-flex;align-items:center;gap:6px;max-width:100%;margin:0;padding:3px 8px 3px 5px;background:transparent;border:1px solid rgba(255,255,255,.16);border-radius:999px;color:inherit;font-size:10.5px;font-weight:500;letter-spacing:.08em;line-height:1;text-decoration:none;text-transform:uppercase;white-space:nowrap;opacity:.35;filter:grayscale(1);transition:opacity .18s ease,filter .18s ease}
  .launchai-featured [data-launchai-badge="featured"]:hover,.launchai-featured [data-launchai-badge="featured"]:focus-visible{opacity:.95;filter:grayscale(0)}
  .launchai-featured [data-launchai-badge="featured"] img{display:block;width:18px;height:18px;object-fit:contain;flex:none}
  .launchai-featured [data-launchai-badge="featured"]>span:last-child{display:inline-flex;align-items:baseline;gap:.4em}
  .launchai-featured [data-launchai-badge="featured"] strong{font-weight:650;letter-spacing:.08em;text-transform:uppercase}
  @layer ascii {
    html[data-ascii] body .launchai-featured [data-launchai-badge="featured"]{border-color:rgba(255,255,255,.16)!important;background-color:transparent!important;color:inherit!important;font-size:10.5px!important;letter-spacing:.08em!important;text-transform:uppercase!important;text-decoration:none!important;min-height:0!important;opacity:.35;filter:grayscale(1)}
    html[data-ascii] body .launchai-featured [data-launchai-badge="featured"]:hover,html[data-ascii] body .launchai-featured [data-launchai-badge="featured"]:focus-visible{color:inherit!important;text-decoration:none!important;opacity:.95;filter:grayscale(0)}
    html[data-ascii] body .launchai-featured [data-launchai-badge="featured"] img{width:18px!important;height:18px!important}
  }
</style>
