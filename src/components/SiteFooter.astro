---
import { footerGroups } from '../data/site-navigation.mjs';
import BugReport from './BugReport.astro';
import '../styles/site-footer.css';

const bugHref = 'mailto:digivatedbiz@gmail.com?subject=Digivated%20bug%20report';
const groups = footerGroups.filter(group => group.title !== 'Follow');
const socials = footerGroups.find(group => group.title === 'Follow')?.links ?? [];
---
<footer class="dg-site-footer">
  <div class="dg-footer-inner">
    <div class="dg-footer-main">
      <section class="dg-footer-signup" aria-labelledby="footer-digest-title">
        <h2 id="footer-digest-title">The weekly launch digest</h2>
        <p>Up to three new launches every Monday.</p>
        <form action="/api/return-emails?action=subscribe" method="post" data-footer-digest>
          <div class="dg-footer-signup-fields">
            <label class="sr-only" for="footer-digest-email">Email address</label>
            <input id="footer-digest-email" name="email" type="email" autocomplete="email" maxlength="254" placeholder="you@example.com" required/>
            <button class="button primary" type="submit">Subscribe</button>
          </div>
          <p role="status" data-footer-digest-status></p>
          <noscript><p><a href="/dashboard?tab=settings">Subscribe in Email settings</a></p></noscript>
        </form>
      </section>
      <nav class="dg-footer-groups" aria-label="Footer">
        {groups.map(group => <div class="dg-footer-group">
          <h2>{group.title}</h2>
          <ul>
            {group.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
            {group.title === 'Company' && <li><a href={bugHref} data-bug-open>Report a bug</a></li>}
          </ul>
        </div>)}
      </nav>
    </div>
    <div class="dg-footer-bottom">
      <div class="dg-footer-credits">
        <div class="dg-footer-feature"><span>Featured on</span><a class="dg-footer-credit" href="https://launchai.tools" target="_blank" rel="noopener noreferrer" data-launchai-badge="featured" aria-label="Featured on LaunchAI: Digivated">
          <img src="/media/launchai-rocket-mark.png" alt="" width="18" height="18" loading="lazy" decoding="async"/>
          LaunchAI
        </a></div>
        <nav class="dg-footer-utility" aria-label="Digivated social links">
          {socials.map(([href, label]) => <a href={href} target="_blank" rel="noopener noreferrer">{label}</a>)}
        </nav>
      </div>
      <small><a class="dg-footer-brand" href="/">© {new Date().getFullYear()} Digivated</a></small>
    </div>
    <div class="dg-footer-wordmark" aria-hidden="true">digivated</div>
  </div>
</footer>
<BugReport/>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-footer-digest]');
  if (form) {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLElement>('[data-footer-digest-status]')!;
    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (button.disabled) return;
      const email = new FormData(form).get('email');
      button.disabled = true;
      status.textContent = 'Sending…';
      try {
        const response = await fetch(form.action, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }), signal: AbortSignal.timeout(12000),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || data.pending !== true) throw new Error(data.error || 'Couldn’t subscribe. Try again.');
        form.reset();
        status.textContent = 'Check your inbox to confirm. Already subscribed? You’re all set.';
      } catch (error) {
        status.textContent = error instanceof Error && !(error instanceof DOMException)
          ? error.message : 'Couldn’t send confirmation. Try again.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
