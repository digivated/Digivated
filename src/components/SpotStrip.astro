---
// Featured and paid spots, plus open slots anyone can claim. Filled by home-board.js.
---
<section class="dg-spots" data-spots aria-labelledby="dg-spots-title">
  <h2 id="dg-spots-title" class="sr-only">Featured spots</h2>
  <div class="dg-spots-viewport" data-spots-viewport>
    <ul class="dg-spots-track" data-spots-track aria-busy="true">
      {Array.from({ length: 6 }, () => <li class="dg-spot is-loading" aria-hidden="true"><span class="dg-spot-logo"></span><span class="dg-spot-copy"><strong></strong><small></small></span></li>)}
    </ul>
  </div>
  <button class="dg-spots-toggle" type="button" data-spots-toggle aria-pressed="false" aria-label="Pause moving spots"><span aria-hidden="true">❚❚</span></button>
</section>
