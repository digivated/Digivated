---
import resources from '../data/resources.json';
import { resourcePathInfo } from '../data/learning-paths.mjs';
import UiIcon from './UiIcon.astro';
const index = resources.filter(r => r.status === 'published').map(r => ({type:'resource',title:r.title,description:r.description,category:r.category,keywords:resourcePathInfo(r).keywords,href:`/resources/read?slug=${encodeURIComponent(r.slug)}`}));
index.unshift({type:'resource',title:'UI/UX Prompt Packet',description:'75 practical prompts, workflows, and checklists.',category:'Design & UX',href:'/ui-ux-prompt-packet'});
const pages = [
  ['/discover','Projects','Discover independent projects and their builders.','directory explore builders'],
  ['/rankings','Project rankings','See projects ranked by community upvotes.','today weekly monthly votes'],
  ['/news','News','Verified reporting on AI, technology, markets and security.','breaking latest AI tech markets security news'],
  ['/ai-tools','AI tools','Find AI tools by category.','artificial intelligence tools'],
  ['/submit-project','Submit a project','Share your work for review.','submit listing builder'],
  ['/saved','Saved items','Return to your saved projects and collections.','favorites bookmarks collections'],
  ['/membership','Digivated Membership','$5 USD once: a project spotlight and full News briefings.','membership spotlight news summaries one time'],
  ['/account','Your projects','Manage your account, submissions, and feedback.','account profile email login'],
  ['/about','About Digivated','Learn about Digivated.','about contact'],
].map(([href,title,description,keywords]) => ({type:'page',href,title,description,keywords,category:'Digivated'}));
---
<script type="application/json" id="discovery-index" set:html={JSON.stringify([...pages,...index]).replace(/</g,'\u003c')}/>
<dialog class="discovery-dialog search-dialog" id="discovery-search" aria-labelledby="discovery-search-title">
  <div class="search-header">
    <div class="discovery-dialog-head"><div><h2 id="discovery-search-title">Search Digivated</h2><p class="search-subtitle">Find a project, a builder, or your next useful tool.</p></div><button type="button" class="discovery-close" data-close-search aria-label="Close search"><UiIcon name="close" size={18}/></button></div>
    <div class="search-input-wrap"><label class="unified-search-label"><span class="sr-only">Search Digivated</span><UiIcon name="search" size={20}/><input id="unified-search-input" type="search" placeholder="Search Digivated…" autocomplete="off" spellcheck="false" aria-controls="unified-results"/></label><button type="button" id="clear-discovery-search" aria-label="Clear search" hidden><UiIcon name="close" size={16}/></button></div>
    <div class="search-scopes" role="group" aria-label="Search content type"><button type="button" data-search-type="all" aria-pressed="true">All</button><button type="button" data-search-type="project" aria-pressed="false">Projects</button><button type="button" data-search-type="resource" aria-pressed="false">Guides</button></div>
  </div>
  <div class="search-body">
    <nav class="search-shortcuts" id="search-shortcuts" aria-label="Explore Digivated"><a href="/discover"><UiIcon name="grid" size={16}/>Browse projects</a><a href="/ai-tools"><UiIcon name="sparkle" size={16}/>AI tools</a></nav>
    <p class="search-count" id="unified-search-status" role="status" aria-live="polite"></p>
    <nav class="unified-results" id="unified-results" aria-label="Search results"></nav>
    <div class="search-empty" id="unified-search-empty" hidden><span class="search-empty-icon" aria-hidden="true"><UiIcon name="search" size={24}/></span><h3>No matches yet</h3><p>Try a project name, builder, or a broader topic.</p><button type="button" id="reset-discovery-search">Clear search and filters <UiIcon name="arrow" size={15}/></button></div>
  </div>
  <footer class="search-footnote"><span class="search-keyboard-hint"><kbd>↑</kbd><kbd>↓</kbd> Navigate <kbd>↵</kbd> Open</span><span><kbd>Esc</kbd> Close</span></footer>
</dialog>
<dialog class="discovery-dialog preview-dialog" id="project-preview" aria-labelledby="project-preview-title">
  <div class="discovery-dialog-head"><p class="discovery-eyebrow">PROJECT PREVIEW</p><button type="button" class="discovery-close" data-close-preview aria-label="Close project preview">×</button></div>
  <div class="preview-stage" aria-hidden="true"><div class="preview-orbit"></div><div class="preview-identity" id="preview-identity"></div></div>
  <div class="preview-copy"><p class="preview-category" id="preview-category"></p><h2 id="project-preview-title"></h2><p class="preview-creator" id="preview-creator"></p><p class="preview-description" id="preview-description"></p><p class="preview-meta" id="preview-meta"></p><a class="button primary preview-visit" id="preview-visit" target="_blank" rel="noopener noreferrer">Visit project <span aria-hidden="true">↗</span></a></div>
  <div class="preview-navigation"><button type="button" id="preview-previous">← Previous</button><span id="preview-position" role="status"></span><button type="button" id="preview-next">Next →</button></div>
</dialog>
<script>import '../scripts/discovery.js';</script>
