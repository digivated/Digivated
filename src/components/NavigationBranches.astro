---
import { menuGroups, isNavigationCurrent } from '../data/site-navigation.mjs';
import {
  ArrowDown01Icon, Award01Icon, BookOpen01Icon, BubbleChatIcon, Certificate01Icon,
  ChartLineData01Icon, News01Icon, Rocket01Icon, Store01Icon,
} from '@hugeicons/core-free-icons';
import NavGlyph from './NavGlyph.astro';

interface Props { path: string }
const { path } = Astro.props;
const active = (href: string) => isNavigationCurrent(path, href);
const activeBranch = menuGroups.find(({ links }) => links.some(([href]) => active(href))) ?? menuGroups[0];
const branchIcons = [BookOpen01Icon, Rocket01Icon];
const linkIcons: Record<string, typeof Rocket01Icon> = {
  '/news': News01Icon,
  '/winners': Award01Icon,
  '/resources': BookOpen01Icon,
  '/invstr': ChartLineData01Icon,
  '/badges': Certificate01Icon,
  '/points': BubbleChatIcon,
  '/shop': Store01Icon,
};
---
<div class="site-menu-secondary">
  {menuGroups.map(({ label, links }, index) => (
    <details class="site-menu-branch" open={label === activeBranch.label}>
      <summary class="site-menu-branch-trigger">
        <NavGlyph icon={branchIcons[index] ?? BookOpen01Icon}/>
        <span>{label}</span>
        <span class="site-menu-branch-chevron"><NavGlyph icon={ArrowDown01Icon}/></span>
      </summary>
      <ul class="site-menu-links site-menu-branch-links">
        {links.map(([href, label], row) => (
          <li>
            <svg class="site-menu-connector" viewBox="0 0 18 44" preserveAspectRatio="none" fill="none" aria-hidden="true">
              {row < links.length - 1 && <path class="site-menu-trunk" d="M1 0v44" vector-effect="non-scaling-stroke"/>}
              <path class="site-menu-elbow" d="M1 0v14a8 8 0 0 0 8 8h9" vector-effect="non-scaling-stroke"/>
            </svg>
            <a href={href} aria-current={active(href) ? 'page' : undefined}>
              <NavGlyph icon={linkIcons[href] ?? BookOpen01Icon}/>
              <span>{label}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  ))}
</div>
