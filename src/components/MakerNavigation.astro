---
import UiIcon from './UiIcon.astro';
import '../styles/maker-navigation.css';

const { submitting = false } = Astro.props;
const sections = [
  { id: 'projects', label: 'Overview', href: '/dashboard', icon: 'grid' },
  { id: 'analytics', label: 'Analytics', href: '/dashboard?tab=analytics', icon: 'chart' },
  { id: 'profile', label: 'Profile', href: '/dashboard?tab=profile', icon: 'user' },
  { id: 'settings', label: 'Settings', href: '/dashboard?tab=settings', icon: 'sliders' },
];
---
<nav class="maker-navigation" aria-label="Maker workspace">
  {submitting ? (
    <div class="maker-navigation-sections">
      {sections.map(({ label, href, icon }) => <a href={href}><UiIcon name={icon} size={15}/>{label}</a>)}
    </div>
  ) : (
    <div class="maker-navigation-sections" role="tablist" aria-label="Dashboard sections">
      {sections.map(({ id, label, icon }, index) => (
        <button type="button" role="tab" id={`account-tab-${id}`} aria-controls={`account-panel-${id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-account-tab={id}><UiIcon name={icon} size={15}/>{label}</button>
      ))}
    </div>
  )}
  <a class="maker-navigation-launch" id={submitting ? undefined : 'account-submit-cta'} href="/new-launch" aria-current={submitting ? 'page' : undefined}><UiIcon name="upload" size={15}/>New Launch</a>
</nav>
