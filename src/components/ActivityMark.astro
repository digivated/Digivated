---
const { kind } = Astro.props;
const orbit = [[7, 8], [8, 4], [12, 2], [17, 2], [21, 5], [21, 9], [17, 11], [12, 11]];
const dots = kind === 'orbit'
  ? orbit
  : Array.from({ length: 18 }, (_, i) => {
      const column = i % 6;
      const row = Math.floor(i / 6);
      return [3 + column * 4.6, 6 + row * 2.4 + Math.sin(column * 1.07) * 2.8 - column * .4];
    });
---
<span class:list={['dg-activity-mark', `dg-activity-mark-${kind}`]} aria-hidden="true">
  {dots.map(([x, y], i) => (
    <span class="dg-activity-dot" style={`--dot-x:${x}px;--dot-y:${y}px;--dot-delay:${-(kind === 'orbit' ? i : i % 6) * .24}s`}></span>
  ))}
</span>
