---
import { isNavigationCurrent } from '../data/site-navigation.mjs';
import NavigationTree from './NavigationTree.astro';
import UiIcon from './UiIcon.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => isNavigationCurrent(path, href);
---
<aside class="dg-workspace-rail" aria-label="Digivated sidebar">
  <a class="dg-rail-brand" href="/" aria-label="Digivated home">
    <span class="dg-rail-mark"><img src="/digivated-new-mark.svg" alt="" width="34" height="34"/></span>
    <span>Digivated</span>
  </a>
  <slot/>
  <nav class="dg-rail-navigation" aria-label="Workspace navigation">
    <NavigationTree path={path}/>
    <a class="navigation-launch" href="/new-launch" aria-current={current('/new-launch') ? 'page' : undefined}><UiIcon name="upload" size={16}/>New Launch</a>
  </nav>
</aside>
