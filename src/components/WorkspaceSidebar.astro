---
import { primaryLinks, isNavigationCurrent } from '../data/site-navigation.mjs';
import NavigationBranches from './NavigationBranches.astro';
import UiIcon from './UiIcon.astro';
import ReactBits from './ReactBits.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => isNavigationCurrent(path, href);
const icons: Record<string, string> = { '/': 'layers', '/discover': 'grid', '/threads': 'comment' };
const links = primaryLinks.map(([href, label]) => ({ href, label, current: current(href), icon: icons[href] || 'arrow' }));
---
<aside class="dg-workspace-rail" aria-label="Digivated sidebar">
  <a class="dg-rail-brand" href="/" aria-label="Digivated home">
    <span class="dg-rail-mark"><img src="/digivated-daylight-mark.png" alt="" width="34" height="34"/></span>
    <span>Digivated</span>
  </a>
  <slot/>
  <nav class="dg-rail-navigation" aria-label="Workspace navigation">
    <div class="dg-rail-primary"><ReactBits surface="RailLinks" links={links}/></div>
    <NavigationBranches path={path}/>
  </nav>
  <div class="dg-rail-footer">
    <a class="dg-rail-about" href="/about" aria-current={current('/about') ? 'page' : undefined}>About Digivated <UiIcon name="arrow" size={14}/></a>
    <ReactBits surface="GlassAction" className="dg-rail-submit" href="/submit-project" label="Submit a launch" icon="upload" light aria-current={current('/submit-project') ? 'page' : undefined}/>
  </div>
</aside>
