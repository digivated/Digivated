---
import { primaryLinks, menuGroups } from '../data/site-navigation.mjs';
import UiIcon from './UiIcon.astro';
import '../styles/site-header.css';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = (link: string) => { const href = link.split('?')[0]; if (link.includes('?')) return false; return path === href || path.startsWith(href + '/') || (href === '/discover' && path.startsWith('/projects/')) || (href === '/shop' && ['/membership','/products','/promote','/founding-members'].includes(path)); };
---
<header class="platform-header compact-site-header" data-account="signed-out">
  <div class="header-inner">
    <a class="platform-brand" href="/" aria-label="Digivated home"><img class="daylight-brand-mark" src="/digivated-daylight-mark.png" width="32" height="32" alt=""/><span>Digivated</span></a>
    <nav class="header-primary" aria-label="Primary navigation">{primaryLinks.map(([href,label])=><a href={href} aria-current={active(href)?'page':undefined}>{label}</a>)}</nav>
    <div class="compact-header-actions">
      <button class="header-search" type="button" data-open-search aria-label="Search Digivated"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg></button>
      <a class="header-inbox header-notifications" id="header-notifications-link" href="/notifications" aria-label="Notifications" aria-current={active('/notifications')?'page':undefined}><UiIcon name="bell" size={20}/><span id="header-notifications-badge" class="header-inbox-badge" hidden></span></a>
      <a class="header-login" id="header-account-link" href="/login" aria-current={active('/login')?'page':undefined}>Log In</a>
      <div class="fl-menu" id="header-account-menu" hidden>
        <button type="button" class="fl-menu-trigger" id="header-account-trigger" aria-labelledby="header-account-label" aria-haspopup="menu" aria-expanded="false" aria-controls="header-account-panel"><span class="fl-avatar" id="header-account-avatar" aria-hidden="true">D</span><span class="fl-menu-name sr-only" id="header-account-label">Account menu</span><span class="fl-menu-caret" aria-hidden="true">▾</span><span id="header-account-dot" class="header-inbox-badge" hidden></span></button>
        <div class="fl-menu-panel" id="header-account-panel" role="menu" aria-labelledby="header-account-trigger" hidden>
          <span class="fl-menu-who" role="presentation"><strong>Signed in</strong><span id="header-account-email"></span><span class="fl-menu-points"><span aria-hidden="true">✦</span> <b id="header-menu-points" hidden>0</b> feedback points</span></span>
          <a role="menuitem" href="/account">Dashboard</a>
          <a role="menuitem" href="/inbox">Inbox <span class="fl-menu-count" id="header-menu-inbox" hidden></span></a>
          <a role="menuitem" href="/saved">Saved items</a>
          <a role="menuitem" href="/account?tab=settings">Settings</a>
          <hr/>
          <button role="menuitem" type="button" id="header-sign-out">Sign out</button>
        </div>
      </div>
      <a class="dg-header-submit" href="/submit-project" aria-current={active('/submit-project')?'page':undefined}><span>Submit</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <details class="explore-menu notebook-navigation" data-navigation>
        <summary class="site-menu-trigger" aria-controls="explore-navigation" aria-label="Open navigation menu" aria-expanded="false"><span class="site-menu-trigger-label">Menu</span><span class="navigation-trigger-menu"><UiIcon name="menu" size={18}/></span><span class="navigation-trigger-close"><UiIcon name="close" size={18}/></span></summary>
        <nav id="explore-navigation" class="site-menu-panel" aria-label="Site menu">
          <div class="site-menu-primary">
            <p class="site-menu-title">Browse</p>
            <div class="site-menu-links">{primaryLinks.map(([href,label])=><a href={href} aria-current={active(href)?'page':undefined}>{label}</a>)}</div>
          </div>
          <div class="site-menu-groups">{menuGroups.map(group=><div class="site-menu-group"><p class="site-menu-title">{group.title}</p><div class="site-menu-links">{group.links.map(([href,label])=><a href={href} aria-current={active(href)?'page':undefined}>{label}</a>)}</div></div>)}</div>
          <div class="site-menu-footer"><a id="menu-account-link" href="/account">Your projects</a><a href="/about">About</a><a id="menu-login-link" href="/login">Log in or sign up</a></div>
        </nav>
      </details>
    </div>
  </div>
</header>
<script is:inline src="/header-session.js"></script>
<script>import '../scripts/account-header.js'; import '../scripts/notification-bell.js';</script>
