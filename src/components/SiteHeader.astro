---
import { primaryLinks, menuGroups } from '../data/site-navigation.mjs';
import {
  ArrowDown01Icon, Award01Icon, BookOpen01Icon, BubbleChatIcon, Certificate01Icon,
  ChartLineData01Icon, News01Icon, Rocket01Icon, Store01Icon,
} from '@hugeicons/core-free-icons';
import NavGlyph from './NavGlyph.astro';
import UiIcon from './UiIcon.astro';
import '../styles/site-header.css';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = (link: string) => { const href = link.split('?')[0]; if (link.includes('?')) return false; return path === href || path.startsWith(href + '/') || (href === '/discover' && path.startsWith('/projects/')) || (href === '/shop' && ['/membership','/products','/promote','/founding-members'].includes(path)); };
const activeBranch = menuGroups.findIndex(group => group.links.some(([href]) => active(href)));
const branchIcons = [BookOpen01Icon, Rocket01Icon];
const linkIcons: Record<string, typeof Rocket01Icon> = {
  '/news': News01Icon,
  '/winners': Award01Icon,
  '/resources': BookOpen01Icon,
  '/invstr': ChartLineData01Icon,
  '/badges': Certificate01Icon,
  '/points': BubbleChatIcon,
  '/shop': Store01Icon,
};
---
<header class="dg-shell" data-site-header data-account="signed-out">
  <div class="dg-shell-bar" data-nav-reflection>
    <div class="dg-shell-material" aria-hidden="true"></div>
    <a class="dg-shell-brand" href="/" aria-label="Digivated home"><img class="daylight-brand-mark" src="/digivated-daylight-mark.png" width="32" height="32" alt=""/><span>Digivated</span></a>
    <nav class="dg-shell-primary" aria-label="Primary navigation">{primaryLinks.map(([href,label])=><a href={href} aria-current={active(href)?'page':undefined}>{label}</a>)}</nav>
    <div class="dg-shell-tools">
      <a class="dg-shell-icon dg-shell-notifications" id="header-notifications-link" href="/notifications" aria-label="Notifications" aria-current={active('/notifications')?'page':undefined}><UiIcon name="bell" size={20}/><span id="header-notifications-badge" class="dg-shell-badge" hidden></span></a>
      <a class="dg-shell-login" id="header-account-link" href="/login" aria-current={active('/login')?'page':undefined}>Log In</a>
      <div class="dg-shell-account" id="header-account-menu" hidden>
        <button type="button" class="dg-shell-avatar-trigger" id="header-account-trigger" aria-labelledby="header-account-label" aria-haspopup="menu" aria-expanded="false" aria-controls="header-account-panel"><span class="dg-shell-avatar" id="header-account-avatar" aria-hidden="true">D</span><span class="fl-menu-name sr-only" id="header-account-label">Account menu</span><span class="dg-shell-account-caret" aria-hidden="true">▾</span><span id="header-account-dot" class="dg-shell-badge" hidden></span></button>
        <div class="dg-shell-account-panel" data-nav-reflection id="header-account-panel" role="menu" aria-labelledby="header-account-trigger" hidden>
          <span class="dg-shell-account-who" role="presentation"><strong>Signed in</strong><span id="header-account-email"></span><span class="fl-menu-points"><span aria-hidden="true">✦</span> <b id="header-menu-points" hidden>0</b> feedback points</span></span>
          <a role="menuitem" href="/account">Your projects</a>
          <a role="menuitem" href="/inbox">Inbox <span class="fl-menu-count" id="header-menu-inbox" hidden></span></a>
          <a role="menuitem" href="/saved">Saved items</a>
          <a role="menuitem" href="/account?tab=settings">Settings</a>
          <hr/>
          <button role="menuitem" type="button" id="header-sign-out">Sign out</button>
        </div>
      </div>
      <a class="dg-header-submit" data-glass-surface="action" href="/submit-project" aria-label="Submit a product" aria-current={active('/submit-project')?'page':undefined}><span>Submit</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <details class="dg-shell-disclosure" data-navigation>
        <summary class="site-menu-trigger" aria-controls="explore-navigation">
          <span class="dg-shell-more-label">More</span>
          <span class="dg-shell-menu-label">Menu</span>
          <svg class="dg-shell-more-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          <span class="dg-shell-menu-open" aria-hidden="true"><UiIcon name="menu" size={18}/></span>
          <span class="dg-shell-menu-close" aria-hidden="true"><UiIcon name="close" size={18}/></span>
        </summary>
        <nav id="explore-navigation" class="site-menu-panel" data-nav-reflection aria-label="Site menu">
          <div class="site-menu-primary site-menu-links">
            {primaryLinks.map(([href, label]) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}
          </div>
          <div class="site-menu-secondary">
            {menuGroups.map(({ label, links }, index) => (
              <details class="site-menu-branch" open={index === (activeBranch < 0 ? 0 : activeBranch)}>
                <summary class="site-menu-branch-trigger">
                  <NavGlyph icon={branchIcons[index] ?? BookOpen01Icon}/>
                  <span>{label}</span>
                  <span class="site-menu-branch-chevron"><NavGlyph icon={ArrowDown01Icon}/></span>
                </summary>
                <ul class="site-menu-links site-menu-branch-links">
                  {links.map(([href, label], row) => (
                    <li>
                      <svg class="site-menu-connector" viewBox="0 0 18 44" preserveAspectRatio="none" fill="none" aria-hidden="true">
                        {row < links.length - 1 && <path class="site-menu-trunk" d="M1 0v44" vector-effect="non-scaling-stroke"/>}
                        <path class="site-menu-elbow" d="M1 0v14a8 8 0 0 0 8 8h9" vector-effect="non-scaling-stroke"/>
                      </svg>
                      <a href={href} aria-current={active(href) ? 'page' : undefined}>
                        <NavGlyph icon={linkIcons[href] ?? BookOpen01Icon}/>
                        <span>{label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ))}
          </div>
        </nav>
      </details>
    </div>
  </div>
  <span class="dg-reading-track" data-reading-progress aria-hidden="true"></span>
</header>
<script is:inline src="/header-session.js"></script>
<script>
import '../scripts/navigation-glass.js';
import '../scripts/navigation-reflection.js';
import '../scripts/account-header.js';
import '../scripts/notification-bell.js';
</script>
