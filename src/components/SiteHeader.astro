---
import { isNavigationCurrent } from '../data/site-navigation.mjs';
import NavigationTree from './NavigationTree.astro';
import UiIcon from './UiIcon.astro';
import '../styles/site-header.css';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = (href: string) => isNavigationCurrent(path, href);
---
<header class="dg-shell" data-site-header data-account="signed-out">
  <div class="dg-shell-bar">
    <div class="dg-shell-material" aria-hidden="true"></div>
    <a class="dg-shell-brand" href="/" aria-label="Digivated home"><img class="daylight-brand-mark" src="/digivated-new-mark.svg" width="32" height="32" alt=""/><span>Digivated</span></a>
    <div class="dg-shell-tools">
      <a class="dg-shell-icon dg-shell-notifications" id="header-notifications-link" href="/notifications" aria-label="Notifications" aria-current={active('/notifications')?'page':undefined}><UiIcon name="bell" size={20}/><span id="header-notifications-badge" class="dg-shell-badge" hidden></span></a>
      <a class="dg-shell-login" id="header-account-link" href="/login" aria-current={active('/login')?'page':undefined}>Log In</a>
      <div class="dg-shell-account" id="header-account-menu" hidden>
        <button type="button" class="dg-shell-avatar-trigger" id="header-account-trigger" aria-labelledby="header-account-label" aria-haspopup="menu" aria-expanded="false" aria-controls="header-account-panel"><span class="dg-shell-avatar" id="header-account-avatar" aria-hidden="true">D</span><span class="fl-menu-name sr-only" id="header-account-label">Account menu</span><span class="dg-shell-account-caption" aria-hidden="true">Account</span><span class="dg-shell-account-caret" aria-hidden="true"><UiIcon name="chevron" size={15}/></span><span id="header-account-dot" class="dg-shell-badge" hidden></span></button>
        <div class="dg-shell-account-panel" id="header-account-panel" role="menu" aria-labelledby="header-account-trigger" hidden>
          <span class="dg-shell-account-who" role="presentation"><span id="header-account-email"></span><span class="fl-menu-points"><UiIcon name="sparkle" size={13}/><b id="header-menu-points" hidden>0</b> feedback points</span></span>
          <div class="dg-shell-account-links" role="presentation">
            <a role="menuitem" href="/dashboard"><UiIcon name="grid" size={17}/>Your projects</a>
            <a role="menuitem" href="/saved" aria-current={active('/saved') ? 'page' : undefined}><UiIcon name="save" size={17}/>Saved items</a>
            <a role="menuitem" href="/dashboard?tab=settings"><UiIcon name="sliders" size={17}/>Settings</a>
          </div>
          <button role="menuitem" type="button" id="header-sign-out"><UiIcon name="arrow-left" size={17}/>Sign out</button>
        </div>
      </div>
      <details class="dg-shell-disclosure" data-navigation>
        <summary class="site-menu-trigger" aria-controls="explore-navigation">
          <span class="dg-shell-menu-label">Menu</span>
          <span class="dg-shell-menu-open" aria-hidden="true"><UiIcon name="menu" size={18}/></span>
          <span class="dg-shell-menu-close" aria-hidden="true"><UiIcon name="close" size={18}/></span>
        </summary>
        <nav id="explore-navigation" class="site-menu-panel" aria-label="Site menu">
          <div class="drawer-heading">
            <span><img src="/digivated-new-mark.svg" width="28" height="28" alt=""/>Digivated</span>
            <button type="button" data-menu-close aria-label="Close menu" hidden><UiIcon name="close" size={18}/></button>
          </div>
          <NavigationTree path={path}/>
          <a class="navigation-launch" href="/new-launch" aria-current={active('/new-launch') ? 'page' : undefined}><UiIcon name="upload" size={16}/>New Launch</a>
        </nav>
      </details>
    </div>
  </div>
</header>
<script is:inline src="/header-session.js?v=2"></script>
<script>
import '../scripts/account-header.js';
import '../scripts/notification-bell.js';
</script>
