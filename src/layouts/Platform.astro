---
import SiteCanvas from './SiteCanvas.astro';
import '../styles/global.css';
import '../styles/platform.css';
import '../styles/platform-flow.css';
import '../styles/launch-collections.css';
import '../styles/community-refresh.css';
import '../styles/experience-polish.css';
import '../styles/clean-ui.css';
import '../styles/brand-relaunch.css';
import '../styles/signal-theme.css';
import '../styles/cards.css';
import '../styles/products.css';
import '../styles/workspace-preview.css';
import DiscoveryTools from '../components/DiscoveryTools.astro';
import { footerGroups } from '../data/site-navigation.mjs';
const { title = 'Tech. AI. Markets. What’s next.', description = 'Discover independent projects, useful tools, and the people building them on Digivated.', canonicalPath, noindex = false, showBreadcrumb = true } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const sectionNames: Record<string,string> = { '/threads':'Threads', '/threads/new':'Start a thread', '/discover':'Directory', '/tools':'Tools', '/products':'Membership', '/ui-ux-prompt-packet':'Prompt Packet', '/new-launch':'New Launch', '/dashboard':'Dashboard', '/login':'Log in', '/promote':'Membership', '/about':'About', '/privacy':'Privacy & Data', '/terms':'Terms of Use' };
const breadcrumb = sectionNames[path] || title;
const canonicalUrl = new URL(canonicalPath || path, 'https://digivated.com').href;
const pageType = ['/categories','/discover','/news','/tools','/threads'].includes(path) ? 'CollectionPage' : path === '/about' ? 'AboutPage' : 'WebPage';
const privatePage = ['/dashboard','/notifications','/login','/saved','/email-preferences'].includes(path);
const socialTitle = `${title} · Digivated`;
// Homepage share card. Other platform pages keep /digivated-social-card.png, including /membership.
const socialImage = path === '/' ? 'https://digivated.com/digivated-social-card-v4.png' : 'https://digivated.com/digivated-social-card.png';
const socialImageAlt = 'Get your product discovered on Digivated. Free launches every Monday, shown beside this week\'s launch list.';
const socialProfiles = footerGroups.find(group => group.title === 'Follow')?.links.map(([href]) => href) ?? [];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type':'Organization', '@id':'https://digivated.com/#organization', name:'Digivated', url:'https://digivated.com/', logo:'https://digivated.com/digivated-ascii-icon-transparent.png', sameAs:socialProfiles },
    { '@type':'WebSite', '@id':'https://digivated.com/#website', name:'Digivated', url:'https://digivated.com/', description:'Discover independent projects, give feedback, and share what you are building.', publisher:{'@id':'https://digivated.com/#organization'}, inLanguage:'en' },
    { '@type':pageType, '@id':`${canonicalUrl}#webpage`, name:title, url:canonicalUrl, description, isPartOf:{'@id':'https://digivated.com/#website'}, publisher:{'@id':'https://digivated.com/#organization'}, author:{'@id':'https://digivated.com/#organization'}, inLanguage:'en', ...(path === '/' ? {isAccessibleForFree:true} : {}) }
  ]
};
import '../styles/monochrome.css';
import '../styles/projects-refined.css';
import '../styles/resources-refined.css';
import '../styles/light-theme.css';
import '../styles/motion.css';
import '../styles/public-polish.css';
import '../styles/studio.css';
import '../styles/discovery.css';
import '../styles/resource-expansion.css';
import '../styles/readability.css';
import '../styles/feedback-dialog.css';
import '../styles/notebook.css';
import '../styles/page-alignment.css';
import '../styles/search-and-alignment.css';
---
<!doctype html>
<html id="digivated-root" data-ascii lang="en" data-theme="daylight" style="background:#f6f6f8;color-scheme:light"><head><meta charset="utf-8"/><style is:inline>@layer clean-first, workspace-preview, daylight, flow, ascii;</style><style is:inline media="(prefers-reduced-motion: no-preference)">@view-transition { navigation: auto; }</style><script is:inline src="/vt-origin.js"></script><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><title>{title} · Digivated</title><meta name="description" content={description}/><meta name="author" content="Digivated"/>{(privatePage || noindex) && <meta name="robots" content="noindex,follow"/>}<meta name="theme-color" content="#ffffff"/><link rel="icon" href="/digivated-ascii-icon-transparent.png" type="image/png"/><link rel="apple-touch-icon" href="/digivated-ascii-touch-transparent.png"/><link rel="canonical" href={canonicalUrl}/><script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g,'\\u003c')}/><meta property="og:url" content={canonicalUrl}/><meta property="og:site_name" content="Digivated"/><meta property="og:type" content="website"/><meta property="og:title" content={socialTitle}/><meta property="og:description" content={description}/><meta property="og:image" content={socialImage}/>{path==='/'&&<><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="628"/><meta property="og:image:type" content="image/png"/><meta property="og:image:alt" content={socialImageAlt}/></>}<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:site" content="@digivatedx"/><meta name="twitter:title" content={socialTitle}/><meta name="twitter:description" content={path==='/'?'Get your product discovered. Free launches every Monday at Digivated.':description}/><meta name="twitter:image" content={socialImage}/>{path==='/'&&<meta name="twitter:image:alt" content={socialImageAlt}/>}{path === '/' && <script is:inline src="/account-callback.js"></script>}<link rel="preload" href="/fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous"/><link rel="stylesheet" href="/ascii-flow.css?v=3"/><link rel="stylesheet" href="/dg-board.css?v=6"/><link rel="stylesheet" href="/ascii-silver.css?v=5"/><link rel="stylesheet" href="/dg-theme.css?v=2"/><link rel="stylesheet" href="/daylight.css?v=22"/><link rel="stylesheet" href="/clean.css?v=31"/></head>
<body class:list={['platform', 'light-theme', 'moments-theme', { 'home-refresh': path === '/', 'wall-experience': path === '/' || path === '/discover', 'projects-dashboard': path === '/discover', 'resources-dashboard': path === '/resources/guides', 'community-page': path.startsWith('/community') }]}>
<SiteCanvas>
{showBreadcrumb && path !== '/' && <nav class="site-breadcrumbs" aria-label="Breadcrumb"><a href="/" aria-label="Digivated home"><svg class="breadcrumb-home-icon" aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/></svg><span>Home</span></a><span class="breadcrumb-separator" aria-hidden="true">›</span>{(path.startsWith('/projects/') || path === '/launch-template') && <><a href="/discover">Projects</a><span class="breadcrumb-separator" aria-hidden="true">›</span></>}{path.startsWith('/resources/') && <><a href="/tools">Tools</a><span class="breadcrumb-separator" aria-hidden="true">›</span></>}{path.startsWith('/threads/') && <><a href="/threads">Threads</a><span class="breadcrumb-separator" aria-hidden="true">›</span></>}<span aria-current="page">{breadcrumb}</span></nav>}<slot/>
</SiteCanvas>
<DiscoveryTools/>
<script is:inline defer src="/analytics.js"></script>
<script is:inline defer src="/site-activity.js"></script>
<script is:inline defer src="/_vercel/insights/script.js"></script><script>
import '../scripts/experience-motion.js';
import '../scripts/gentle-motion.js';
import '../scripts/monitoring.js';
import '../scripts/platform-ui.js';
import '../scripts/collections.js';
import '../scripts/motion.js';
import '../scripts/card-actions.js';
import '../scripts/resource-views.js';
import '../scripts/count-motion.js';
</script>


</body></html>
