---
import '../styles/global.css';
import '../styles/platform.css';
import '../styles/launch-collections.css';
import '../styles/community-refresh.css';
import '../styles/experience-polish.css';
import '../styles/clean-ui.css';
import '../styles/brand-relaunch.css';
import '../styles/signal-theme.css';
import '../styles/cards.css';
import '../styles/products.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DiscoveryTools from '../components/DiscoveryTools.astro';
const { title = 'Tech. AI. Markets. What’s next.', description = 'Discover independent projects, useful tools, and the people building them on Digivated.', canonicalPath, noindex = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// Discover and project details share a sticky header and use direct page navigation.
// Native page transitions briefly duplicate the sticky header during navigation.
const sectionNames: Record<string,string> = { '/discover':'Projects', '/resources':'Resources', '/products':'Membership', '/ui-ux-prompt-packet':'Prompt Packet', '/submit-project':'Submit Project', '/account':'Your Projects', '/login':'Log in', '/promote':'Membership', '/about':'About', '/privacy':'Privacy & Data', '/terms':'Terms of Use' };
const breadcrumb = sectionNames[path] || title;
const canonicalUrl = new URL(canonicalPath || path, 'https://digivated.com').href;
const pageType = ['/discover','/news','/resources','/rankings','/creators'].includes(path) ? 'CollectionPage' : path === '/about' ? 'AboutPage' : 'WebPage';
const privatePage = ['/account','/inbox','/notifications','/login','/saved','/email-preferences'].includes(path);
const socialTitle = `${title} · Digivated`;
// Homepage share card. Other platform pages keep /digivated-social-card.png, including /membership.
const socialImage = path === '/' ? 'https://digivated.com/digivated-social-card-v3.png' : 'https://digivated.com/digivated-social-card.png';
const socialImageAlt = 'Get your product discovered on Digivated. A preview of the project directory.';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type':'Organization', '@id':'https://digivated.com/#organization', name:'Digivated', url:'https://digivated.com/', logo:'https://digivated.com/digivated-ascii-icon-transparent.png', sameAs:['https://x.com/digivatedx','https://www.threads.com/@digivated'] },
    { '@type':'WebSite', '@id':'https://digivated.com/#website', name:'Digivated', url:'https://digivated.com/', description:'Discover independent projects, give feedback, and share what you are building.', publisher:{'@id':'https://digivated.com/#organization'}, inLanguage:'en' },
    { '@type':pageType, '@id':`${canonicalUrl}#webpage`, name:title, url:canonicalUrl, description, isPartOf:{'@id':'https://digivated.com/#website'}, publisher:{'@id':'https://digivated.com/#organization'}, inLanguage:'en', ...(path === '/' ? {isAccessibleForFree:true} : {}) }
  ]
};
import '../styles/monochrome.css';
import '../styles/projects-refined.css';
import '../styles/resources-refined.css';
import '../styles/atmosphere.css';
import '../styles/light-theme.css';
import '../styles/motion.css';
import '../styles/site-motion.css';
import '../styles/public-polish.css';
import '../styles/studio.css';
import '../styles/discovery.css';
import '../styles/resource-expansion.css';
import '../styles/readability.css';
import '../styles/compact-navigation.css';
import '../styles/account-announcement.css';
import '../styles/feedback-dialog.css';
import '../styles/notebook.css';
import '../styles/navigation.css';
import '../styles/page-alignment.css';
import '../styles/search-and-alignment.css';
import '../styles/page-transitions.css';
---
<!doctype html>
<html id="digivated-root" data-ascii lang="en" data-theme="dark-glass" style="background:#050505;color-scheme:dark"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><title>{title} · Digivated</title><meta name="description" content={description}/>{(privatePage || noindex) && <meta name="robots" content="noindex,follow"/>}<meta name="theme-color" content="#050505"/><link rel="icon" href="/digivated-ascii-icon-transparent.png" type="image/png"/><link rel="apple-touch-icon" href="/digivated-ascii-touch-transparent.png"/><link rel="canonical" href={canonicalUrl}/><script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g,'\\u003c')}/><meta property="og:url" content={canonicalUrl}/><meta property="og:site_name" content="Digivated"/><meta property="og:title" content={socialTitle}/><meta property="og:description" content={description}/><meta property="og:image" content={socialImage}/>{path==='/'&&<><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="628"/><meta property="og:image:type" content="image/png"/><meta property="og:image:alt" content={socialImageAlt}/></>}<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:site" content="@digivatedx"/><meta name="twitter:title" content={socialTitle}/><meta name="twitter:description" content={path==='/'?'Get your project seen. Submit your project for free at Digivated.':description}/><meta name="twitter:image" content={socialImage}/>{path==='/'&&<meta name="twitter:image:alt" content={socialImageAlt}/>}<link rel="stylesheet" href="/site-intro.css"/><script is:inline src="/site-intro.js"></script><link rel="stylesheet" href="/ascii-silver.css"/></head>
<body class:list={['platform', 'light-theme', 'moments-theme', { 'home-refresh': path === '/', 'wall-experience': path === '/' || path === '/discover', 'projects-dashboard': path === '/discover', 'resources-dashboard': path === '/resources/guides', 'community-page': path.startsWith('/community') }]}><div id="site-intro" hidden aria-hidden="true"><span class="site-intro-mark"><img src="/digivated-ascii-icon-transparent.png" width="74" height="74" alt=""/></span></div><div class="site-atmosphere" aria-hidden="true"></div><a class="skip" href="#main">Skip to content</a>
<SiteHeader/>
{path !== '/login' && path !== '/account' && path !== '/submit-project' && path !== '/creators' && path !== '/inbox' && path !== '/notifications' && <aside id="account-announcement" class="account-announcement" aria-label="Digivated announcement" hidden><div class="account-announcement-copy"><span class="account-announcement-tag">NEW ON DIGIVATED</span><strong id="announcement-title">Accounts are live.</strong><span id="announcement-description">Sign up to track your projects and see feedback in one place. You can still browse without an account.</span></div><div class="account-announcement-actions"><a id="announcement-link" href="/login?mode=signup">Create an account <span aria-hidden="true">→</span></a><button type="button" id="account-announcement-close" aria-label="Dismiss announcement">×</button></div></aside>}

<script is:inline type="module" src="/ascii-field.js"></script>
<main id="main" tabindex="-1">{path !== '/' && <nav class="site-breadcrumbs" aria-label="Breadcrumb"><a href="/" aria-label="Digivated home"><svg class="breadcrumb-home-icon" aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/></svg><span>Home</span></a><span class="breadcrumb-separator" aria-hidden="true">›</span>{(path.startsWith('/projects/') || path === '/launch-template') && <><a href="/discover">Projects</a><span class="breadcrumb-separator" aria-hidden="true">›</span></>}{path.startsWith('/resources/') && <><a href="/resources">Resources</a><span class="breadcrumb-separator" aria-hidden="true">›</span></>}<span aria-current="page">{breadcrumb}</span></nav>}<slot/></main>
<SiteFooter/>
<DiscoveryTools/>
<script is:inline src="/analytics.js"></script>
<script is:inline defer src="/site-activity.js"></script>
<script is:inline defer src="/_vercel/insights/script.js"></script><script>
import '../scripts/experience-motion.js';
import '../scripts/monitoring.js';
import '../scripts/platform-ui.js';
import '../scripts/collections.js';
import '../scripts/motion.js';
import '../scripts/card-actions.js';
import '../scripts/resource-views.js';
import '../scripts/account-announcement.js';
import '../scripts/count-motion.js';
</script>
{path === '/' && <script is:inline>if(location.hash.includes('access_token='))location.replace('/account'+location.hash);</script>}

</body></html>
