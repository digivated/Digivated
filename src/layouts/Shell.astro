---
import SiteCanvas from './SiteCanvas.astro';
import '../styles/global.css';
import '../styles/workspace-preview.css';
import '../styles/reference-design.css';
import '../styles/packet-theme.css';
const {title='UI Prompt Package',section='home',description}=Astro.props;
const workspace=['library','fixes','builder','workflows','checklists','learn','toolkit'].includes(section);
const links=[['start','Start Here'],['library','Prompt library'],['fixes','Help me choose'],['builder','Customize a prompt'],['workflows','Step-by-step guides'],['checklists','Review checklists'],['learn','Learn the basics'],['toolkit','My saved work']];
const siteTitle=`${title} · Digivated Prompt Packet`;
const canonicalUrl = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', 'https://digivated.com').href;
const socialTitle=siteTitle;
const siteDescription=description || 'A beginner-friendly UI prompt package with 75 detailed prompts, workflows, checklists, and a prompt builder for improving websites and apps with AI.';
const siteUrl='https://digivated.com';
const previewImage=`${siteUrl}/digivated-social-card.png`;
import '../styles/monochrome.css';
import '../styles/readability.css';
---
<!doctype html><html id="digivated-root" data-ascii lang="en" data-theme="daylight" style="background:#f7f7fa;color-scheme:light"><head><meta charset="UTF-8"/><style is:inline>@layer clean-first, workspace-preview, daylight, flow, ascii;</style><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="description" content={siteDescription}/><meta name="theme-color" content="#f7f7fa"/><link rel="canonical" href={canonicalUrl}/>{section==='toolkit'&&<meta name="robots" content="noindex,follow"/>}<meta property="og:type" content="website"/><meta property="og:site_name" content="Digivated"/><meta property="og:title" content={socialTitle}/><meta property="og:description" content={siteDescription}/><meta property="og:url" content={canonicalUrl}/><meta property="og:image" content={previewImage}/><meta property="og:image:secure_url" content={previewImage}/><meta property="og:image:type" content="image/png"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Digivated: get your product discovered."/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={socialTitle}/><meta name="twitter:description" content={siteDescription}/><meta name="twitter:image" content={previewImage}/><meta name="twitter:image:alt" content="Digivated: get your product discovered."/><link rel="icon" href="/digivated-ascii-icon-transparent.png" type="image/png"/><link rel="apple-touch-icon" href="/digivated-ascii-touch-transparent.png"/><title>{siteTitle}</title><link rel="stylesheet" href="/ascii-flow.css?v=3"/><link rel="stylesheet" href="/ascii-silver.css?v=5"/><link rel="stylesheet" href="/dg-theme.css?v=2"/><link rel="stylesheet" href="/daylight.css?v=22"/><link rel="stylesheet" href="/clean.css?v=36"/></head>
<body class="packet-workspace" data-section={section} data-surface={workspace?'workspace':'editorial'}>
<SiteCanvas>
  <nav class="packet-tools" aria-label="Packet navigation">
    <a href="/ui-ux-prompt-packet">Prompt Packet</a>
    <details><summary>Packet tools</summary><div>{links.map(([slug,label])=><a href={'/'+slug} aria-current={section===slug?'page':undefined}>{label}</a>)}</div></details>
    <span id="edition-label">Free edition</span><a href="/access">Packet access</a><a href="/membership">Membership</a>
  </nav>
  <slot/>
</SiteCanvas>
<div id="toast" class="toast" role="status" aria-live="polite"></div>
<script is:inline src="/analytics.js"></script>
<script is:inline defer src="/_vercel/insights/script.js"></script>
<script>import '../scripts/experience-motion.js'; import '../scripts/gentle-motion.js'; import '../scripts/monitoring.js'; import '../scripts/app.js'; import '../scripts/platform-ui.js';</script>

</body></html>

