# Example variable names only. Configure real values in Vercel; never commit secrets.
# Production origin and core content storage.
APP_ORIGIN=https://digivated.com
SUBMISSIONS_ORIGIN=https://digivated.com
SUBMISSIONS_REDIS_REST_URL=
SUBMISSIONS_REDIS_REST_TOKEN=

# Owner dashboard. Use a generated password hash and an independent session secret.
DIGIVATED_ADMIN_ORIGIN=https://digivated.com
DIGIVATED_ADMIN_PASSWORD_HASH=
DIGIVATED_ADMIN_SESSION_SECRET=

# Creator accounts and media. Keep the secret key server-side.
COMMUNITY_SUPABASE_URL=
COMMUNITY_SUPABASE_PUBLISHABLE_KEY=
COMMUNITY_SUPABASE_SECRET_KEY=
COMMUNITY_GOOGLE_ENABLED=false

# One-time membership and News. Product ID and access token come from Gumroad.
FOUNDING_ACCESS_ENABLED=false
FOUNDING_GUMROAD_PRODUCT_ID=
FOUNDING_GUMROAD_ACCESS_TOKEN=
FOUNDING_SESSION_SECRET=
# Seller token used only for authorized storefront maintenance.
GUMROAD_ACCESS_TOKEN=
NEWS_AUTO_PUBLISH_ENABLED=false
CRON_SECRET=

# Optional account email and weekly mail.
RESEND_API_KEY=
ACCOUNT_EMAIL_FROM=
WEEKLY_EMAIL_FROM=
WEEKLY_EMAIL_POSTAL_ADDRESS=

# Optional monitoring and visitor reporting.
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Legacy Prompt Packet access for existing customers. Leave disabled for new sales.
ACCESS_ENABLED=false
GUMROAD_PRODUCT_ID=
SESSION_SECRET=
EDITION_KEY=
ALLOW_TEST_PURCHASES=false

# Optional carousel publishing. Set only for an authorized publishing workflow.
CAROUSEL_PUBLISH_SECRET=
