{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build && npm run monitoring:deploy && node scripts/verify-sentry.mjs && node scripts/initialize-news.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/news-ingest.js": {
      "includeFiles": "server/**",
      "maxDuration": 300
    },
    "api/x-research.js": {
      "maxDuration": 300
    },
    "api/x-publish.js": {
      "maxDuration": 120
    },
    "api/admin.js": {
      "includeFiles": "{server/**,gumroad/**}",
      "maxDuration": 120
    },
    "api/submissions.js": {
      "maxDuration": 35
    },
    "api/sitemap.js": {
      "includeFiles": "{server/**,src/data/resources.json}",
      "maxDuration": 15
    },
    "api/*.js": {
      "includeFiles": "server/**",
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/((?!video-player(?:/|$)).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://public-files.gumroad.com https://cglkjclolglwizwepvmy.supabase.co https://*.google-analytics.com; media-src 'self' blob: https://cglkjclolglwizwepvmy.supabase.co; font-src 'self'; connect-src 'self' https://cglkjclolglwizwepvmy.supabase.co wss://cglkjclolglwizwepvmy.supabase.co https://o4512195501228032.ingest.us.sentry.io https://*.google-analytics.com https://www.googletagmanager.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/video-player/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; media-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self' https://x.com https://*.x.com https://twitter.com https://*.twitter.com; form-action 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/downloads/Digivated-X-Video.mp4",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Digivated-X-Video.mp4\""
        },
        {
          "key": "Content-Type",
          "value": "video/mp4"
        }
      ]
    }
  ],
  "redirects": [
    {"source":"/carousels","destination":"/resources/guides","permanent":true},
    {"source":"/carousels/:slug","destination":"/resources/guides","permanent":true},
    {"source":"/carousels/read","destination":"/resources/guides","permanent":true},
    {
      "source": "/ai-tools",
      "destination": "/resources",
      "permanent": true
    },
    {
      "source": "/shop",
      "destination": "/membership",
      "permanent": true
    },
    {
      "source": "/products",
      "destination": "/membership",
      "permanent": true
    },
    {
      "source": "/promote",
      "destination": "/membership",
      "permanent": true
    },
    {
      "source": "/founding-members",
      "destination": "/membership",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "digitalpromptpackage.vercel.app"
        }
      ],
      "destination": "https://digivated.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "digivated.vercel.app"
        }
      ],
      "destination": "https://digivated.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "digivated.vercel.app"
        }
      ],
      "destination": "https://digivated.com/:path*",
      "permanent": true
    },
    {
      "source": "/about-langston",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "digitalpromptpackage.vercel.app"
        }
      ],
      "destination": "https://digivated.com/:path*",
      "permanent": true
    },
    {
      "source": "/community",
      "destination": "https://digivated.com/",
      "permanent": false
    },
    {
      "source": "/community/chat",
      "destination": "https://digivated.com/",
      "permanent": false
    },
    {
      "source": "/community/members",
      "destination": "https://digivated.com/",
      "permanent": false
    },
    {
      "source": "/community/profile",
      "destination": "https://digivated.com/",
      "permanent": false
    },
    {
      "source": "/community/settings",
      "destination": "https://digivated.com/",
      "permanent": false
    },
    {
      "source": "/community/moderate",
      "destination": "https://digivated.com/",
      "permanent": false
    },
    {
      "source": "/community/alerts",
      "destination": "https://digivated.com/",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/weekly-digest",
      "schedule": "0 15 * * 0"
    },
    {
      "path": "/api/news-ingest",
      "schedule": "0 8,20 * * *"
    },
    {
      "path": "/api/launch-queue",
      "schedule": "10 0 * * *"
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/googlef8b001e22ee0d4b9.html", "destination": "/api/google-site-verification" },
    { "source": "/projects/listing/:id", "destination": "/api/project-page?listing=:id" },
    {
      "source": "/projects/:slug",
      "destination": "/api/project-page?slug=:slug"
    }
  ]
}
